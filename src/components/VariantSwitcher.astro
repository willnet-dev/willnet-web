---
// Botones temporales para comparar las versiones de la ronda 21 (pedido de Willder, 2026-11-16).
// Solo existen en el servidor local (npm run dev): HomeView los incluye con import.meta.env.DEV,
// así que nunca llegan a la web publicada. Cambian la versión al instante, sin recargar ni perder
// el scroll, y dejan la dirección (?hero=…&seccion3d=…) lista para copiar. Se borran al elegir.
const groups = [
  { key: "hero", attr: "heroV", label: "Hero" },
  { key: "seccion3d", attr: "labV", label: "3D" },
];
---

<div class="vs" data-vs>
  <button type="button" class="vs__toggle" data-vs-toggle aria-expanded="true" aria-label="Mostrar u ocultar el selector de versiones">
    <span aria-hidden="true">⇄</span>
  </button>
  <div class="vs__panel" data-vs-panel>
    {
      groups.map((g) => (
        <div class="vs__row" role="group" aria-label={`Versión del ${g.label}`}>
          <span class="vs__label">{g.label}</span>
          {["a", "b", "c"].map((v) => (
            <button type="button" class="vs__btn" data-vs-key={g.key} data-vs-attr={g.attr} data-vs-value={v} aria-pressed="false">
              {v.toUpperCase()}
            </button>
          ))}
        </div>
      ))
    }
  </div>
</div>

<script>
  function initSwitcher() {
    const root = document.querySelector<HTMLElement>("[data-vs]");
    if (!root) return;
    const html = document.documentElement;
    const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-vs-key]")];

    const paint = () =>
      buttons.forEach((b) => b.setAttribute("aria-pressed", String((html.dataset[b.dataset.vsAttr!] ?? "a") === b.dataset.vsValue)));

    buttons.forEach((b) =>
      b.addEventListener("click", () => {
        const { vsKey, vsAttr, vsValue } = b.dataset;
        html.dataset[vsAttr!] = vsValue!;
        // La W 3D de la versión A sigue el scroll de forma distinta (escenario fijo)
        const lab = document.querySelector<HTMLElement>("[data-lab]");
        if (lab && vsKey === "seccion3d") {
          if (vsValue === "a") lab.dataset.wProgress = "pin";
          else delete lab.dataset.wProgress;
        }
        const url = new URL(location.href);
        url.searchParams.set(vsKey!, vsValue!);
        history.replaceState(history.state, "", url);
        paint();
        window.dispatchEvent(new Event("resize")); // reacomoda el 3D y las animaciones al cambiar de diseño
      }),
    );

    // Recordar si estaba plegado
    const toggle = root.querySelector<HTMLButtonElement>("[data-vs-toggle]")!;
    const setOpen = (open: boolean) => {
      root.classList.toggle("is-closed", !open);
      toggle.setAttribute("aria-expanded", String(open));
      try {
        sessionStorage.setItem("vs-open", open ? "1" : "0");
      } catch {}
    };
    let saved: string | null = null;
    try {
      saved = sessionStorage.getItem("vs-open");
    } catch {}
    setOpen(saved !== "0");
    toggle.addEventListener("click", () => setOpen(root.classList.contains("is-closed")));

    paint();
  }
  document.addEventListener("astro:page-load", initSwitcher);
</script>

<style>
  .vs {
    position: fixed;
    z-index: 60;
    left: 50%;
    top: calc(var(--header-h, 72px) + 0.5rem);
    translate: -50% 0;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: color-mix(in oklab, var(--surface) 88%, transparent);
    backdrop-filter: blur(10px);
    box-shadow: 0 10px 30px -10px rgb(0 0 0 / 0.5);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text);
  }
  .vs__panel {
    display: flex;
    gap: 0.6rem;
  }
  .vs.is-closed .vs__panel {
    display: none;
  }
  .vs__row {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .vs__row + .vs__row {
    padding-left: 0.6rem;
    border-left: 1px solid var(--line);
  }
  .vs__label {
    padding-inline: 0.3rem 0.2rem;
    color: var(--muted);
  }
  .vs__btn,
  .vs__toggle {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    border: 1px solid transparent;
    background: transparent;
    color: inherit;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .vs__btn:hover,
  .vs__toggle:hover {
    border-color: var(--line);
  }
  .vs__btn[aria-pressed="true"] {
    background: var(--accent);
    color: var(--accent-ink);
  }
  .vs__toggle {
    font-size: 1rem;
    background: var(--bg);
  }
</style>
