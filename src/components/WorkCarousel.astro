---
// «All work» en Work: fila de proyectos que se arrastra con inercia y da la vuelta sin fin
// (pedido de Willder, 2026-11-17; idea de la demo «Draggable Infinite Slider» de Osmo, escrita de nuevo).
// - La tarjeta activa (la primera, alineada con el contenido) se ve completa con su texto; las demás, tenues.
// - Se mueve arrastrando (mouse o dedo, con inercia), con las flechas, con ← → o tocando una tarjeta.
// - Contador con números que ruedan (01 / 17).
// - Los filtros de arriba (site.ts) ocultan tarjetas y avisan con el evento «work:filtered»: se reconstruye.
// - Si con un filtro las tarjetas no llenan el ancho, no da la vuelta (se mueve entre la primera y la última).
// - Movimiento reducido: sin inercia ni animación. Sin JavaScript: fila con scroll horizontal.
// Todas las tarjetas miden lo mismo, así que la posición de cada una sale de una cuenta simple
// (índice × paso + desplazamiento, envuelto con gsap.utils.wrap) en vez del helper genérico de GSAP.
import type { CollectionEntry } from "astro:content";
import { workPath, type Lang } from "../i18n/routes";
import { t } from "../i18n/ui";
import { workImg } from "../lib/img";

interface Props {
  lang: Lang;
  projects: CollectionEntry<"work">[];
}
const { lang, projects } = Astro.props;
const copy = t(lang);
const s = copy.workPage.slider;
const pad = (x: number) => String(x).padStart(2, "0");
---

<div class="wc" data-wc>
  <div class="wrap wc__bar">
    <div class="wc__count" aria-hidden="true">
      <span class="wc__digits"><span class="wc__roll" data-wc-roll>{projects.map((_, i) => <span>{pad(i + 1)}</span>)}</span></span>
      <span class="wc__total">/ <span data-wc-total>{pad(projects.length)}</span></span>
    </div>
    <div class="wc__nav">
      <button type="button" class="wc__btn" data-wc-prev aria-label={s.prev}>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </button>
      <button type="button" class="wc__btn" data-wc-next aria-label={s.next}>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </button>
    </div>
  </div>

  <ul class="wc__track" data-wc-track>
    {
      projects.map((x) => {
        const d = x.data;
        const img = lang === "es" ? d.image.es : d.image.en;
        const href = d.hasCase ? workPath(x.id, lang) : d.url || undefined;
        const external = !d.hasCase && !!d.url;
        // Logos, tarjetas y kits se ven enteros sobre su propia imagen desenfocada
        const contain = d.category === "design";
        const paper = img.toLowerCase().endsWith(".png");
        const Tag = href ? "a" : "div";
        return (
          <li class="wc__slide" data-wc-slide data-category={d.category}>
            <Tag href={href} class="wc__link" draggable="false" {...(external ? { target: "_blank", rel: "noopener" } : {})}>
              <span class:list={["wc__media", contain && "wc__media--contain"]}>
                {contain && <img src={workImg(img)} alt="" aria-hidden="true" loading="lazy" decoding="async" class="wc__backdrop" draggable="false" />}
                <img
                  src={workImg(img)}
                  alt={`${d[lang].title} — ${d[lang].type}`}
                  width="1600"
                  height="900"
                  loading="lazy"
                  decoding="async"
                  draggable="false"
                  class:list={["wc__img", contain && paper && "wc__img--paper"]}
                />
              </span>
              <span class="wc__caption">
                <span class="wc__tags">
                  <span class="wc__tag">{d[lang].type}</span>
                  {d.withDopicos && <span class="wc__tag wc__tag--accent">{copy.common.withDopicos}</span>}
                  {d.year > 0 && <span class="wc__year">{d.year}</span>}
                </span>
                <span class="wc__title display">{d[lang].title}</span>
                {href && (
                  <span class="wc__cta">
                    {d.hasCase ? copy.common.viewCase : copy.common.visitSite}
                    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                      <path d={external ? "M7 17 17 7M9 7h8v8" : "M5 12h14M13 6l6 6-6 6"} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </span>
                )}
              </span>
            </Tag>
          </li>
        );
      })
    }
  </ul>
  <p class="sr-only" aria-live="polite" data-wc-live></p>
</div>

<script>
  import { gsap } from "gsap";
  import { Draggable } from "gsap/Draggable";
  import { InertiaPlugin } from "gsap/InertiaPlugin";

  gsap.registerPlugin(Draggable, InertiaPlugin);

  let cleanups: Array<() => void> = [];

  function initCarousel(root: HTMLElement) {
    const track = root.querySelector<HTMLElement>("[data-wc-track]")!;
    const all = [...root.querySelectorAll<HTMLElement>("[data-wc-slide]")];
    const roll = root.querySelector<HTMLElement>("[data-wc-roll]")!;
    const totalEl = root.querySelector<HTMLElement>("[data-wc-total]")!;
    const live = root.querySelector<HTMLElement>("[data-wc-live]")!;
    const prev = root.querySelector<HTMLButtonElement>("[data-wc-prev]")!;
    const next = root.querySelector<HTMLButtonElement>("[data-wc-next]")!;
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const pad = (x: number) => String(x).padStart(2, "0");

    root.classList.add("is-ready");

    let items: HTMLElement[] = [];
    let n = 0;
    let step = 0; // ancho de una tarjeta + espacio
    let edge = 0; // dónde empieza la tarjeta activa (alineada con el contenido de la web)
    let loop = true;
    let wrapX = (v: number) => v;
    const state = { off: 0 }; // desplazamiento en px (negativo = hacia la izquierda)
    let active = -1;
    let announce = false;

    const indexOf = (off: number) => {
      const k = Math.round(-off / step);
      return loop ? ((k % n) + n) % n : gsap.utils.clamp(0, n - 1, k);
    };
    const minOff = () => -(n - 1) * step;

    const setActive = (i: number) => {
      if (i === active) return;
      active = i;
      items.forEach((el, k) => {
        const on = k === i;
        el.toggleAttribute("data-active", on);
        el.setAttribute("aria-hidden", on ? "false" : "true");
        const link = el.querySelector<HTMLElement>(".wc__link");
        if (link?.tagName === "A") link.tabIndex = on ? 0 : -1;
      });
      // yPercent es sobre la columna entera (n números): cada número es 100 / n
      gsap.to(roll, { yPercent: (-100 / n) * i, duration: reduced ? 0 : 0.45, ease: "power3", overwrite: true });
      if (announce) {
        const title = items[i].querySelector(".wc__title")?.textContent ?? "";
        live.textContent = `${pad(i + 1)} / ${pad(n)}: ${title}`;
      }
      if (!loop) {
        prev.disabled = i === 0;
        next.disabled = i === n - 1;
      }
    };

    const render = () => {
      for (let i = 0; i < n; i++) gsap.set(items[i], { x: wrapX(i * step + state.off) });
      setActive(indexOf(state.off));
    };

    // Medidas y lista de tarjetas visibles (cambian con los filtros y el tamaño de pantalla)
    const build = (resetPosition: boolean) => {
      items = all.filter((el) => !el.hidden);
      n = items.length;
      all.forEach((el) => {
        gsap.set(el, { x: 0 });
        el.removeAttribute("data-active");
      });
      if (!n) return;
      const gap = parseFloat(getComputedStyle(track).columnGap) || 24;
      step = items[0].offsetWidth + gap;
      edge = items[0].offsetLeft;
      const total = n * step;
      loop = total >= track.clientWidth + step;
      // Con vuelta: cada tarjeta vive entre «una antes del borde» y «total después»
      wrapX = loop ? gsap.utils.wrap(-edge - step, total - edge - step) : (v: number) => v;
      prev.disabled = next.disabled = false;
      track.style.height = `${Math.max(...items.map((el) => el.offsetHeight))}px`;
      // El contador: los números de las tarjetas visibles
      roll.innerHTML = items.map((_, i) => `<span>${pad(i + 1)}</span>`).join("");
      totalEl.textContent = pad(n);
      if (resetPosition) {
        state.off = 0;
        gsap.set(roll, { yPercent: 0 });
      } else {
        state.off = Math.round(state.off / step) * step;
        if (!loop) state.off = gsap.utils.clamp(minOff(), 0, state.off);
      }
      active = -1;
      render();
      gsap.set(proxy, { x: state.off });
      drag.update();
    };

    let tween: gsap.core.Tween | null = null;
    const moveTo = (off: number) => {
      tween?.kill();
      tween = gsap.to(state, {
        off,
        duration: reduced ? 0 : 0.75,
        ease: "power3",
        onUpdate: render,
        onComplete: () => {
          render();
          gsap.set(proxy, { x: state.off });
          drag.update();
        },
      });
    };
    const go = (delta: number) => {
      announce = true;
      const k = Math.round(-state.off / step) + delta;
      let target = -k * step;
      if (!loop) target = gsap.utils.clamp(minOff(), 0, target);
      moveTo(target);
    };
    const goToIndex = (i: number) => {
      announce = true;
      const cur = Math.round(-state.off / step);
      let d = i - (((cur % n) + n) % n);
      if (loop && Math.abs(d) > n / 2) d -= Math.sign(d) * n; // por el camino más corto
      go(d);
    };

    // Arrastre con inercia: Draggable mueve un elemento invisible y su x es el desplazamiento
    const proxy = document.createElement("div");
    let dragMoved = 0;
    const [drag] = Draggable.create(proxy, {
      type: "x",
      trigger: track,
      dragClickables: true,
      allowNativeTouchScrolling: true,
      minimumMovement: 6,
      inertia: !reduced,
      onPress() {
        tween?.kill();
        gsap.set(proxy, { x: state.off });
        this.update();
        announce = true;
      },
      onDrag() {
        state.off = loop ? this.x : gsap.utils.clamp(minOff() - step * 0.3, step * 0.3, this.x);
        render();
      },
      onThrowUpdate() {
        state.off = this.x;
        render();
      },
      onDragEnd() {
        dragMoved = performance.now();
        if (reduced) moveTo(Math.round(state.off / step) * step);
      },
      snap(v: number) {
        const snapped = Math.round(v / step) * step;
        return loop ? snapped : gsap.utils.clamp(minOff(), 0, snapped);
      },
      onThrowComplete() {
        render();
      },
    });

    // Tocar una tarjeta que no es la activa la trae al frente; la activa abre su enlace
    const onClick = (e: MouseEvent) => {
      if (performance.now() - dragMoved < 300) {
        e.preventDefault();
        return;
      }
      const slide = (e.target as HTMLElement).closest<HTMLElement>("[data-wc-slide]");
      if (!slide) return;
      const i = items.indexOf(slide);
      if (i < 0 || i === active) return;
      e.preventDefault();
      goToIndex(i);
    };
    track.addEventListener("click", onClick, true);

    const onPrev = () => go(-1);
    const onNext = () => go(1);
    prev.addEventListener("click", onPrev);
    next.addEventListener("click", onNext);
    const onKey = (e: KeyboardEvent) => {
      if (e.key === "ArrowLeft") (e.preventDefault(), go(-1));
      else if (e.key === "ArrowRight") (e.preventDefault(), go(1));
    };
    root.addEventListener("keydown", onKey);

    const onFiltered = () => build(true);
    document.addEventListener("work:filtered", onFiltered);
    let lastW = track.clientWidth;
    const ro = new ResizeObserver(() => {
      if (track.clientWidth === lastW) return;
      lastW = track.clientWidth;
      build(false);
    });
    ro.observe(track);

    build(true);

    cleanups.push(() => {
      drag.kill();
      tween?.kill();
      ro.disconnect();
      document.removeEventListener("work:filtered", onFiltered);
    });
  }

  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLElement>("[data-wc]").forEach(initCarousel);
  });
  document.addEventListener("astro:before-swap", () => {
    cleanups.forEach((fn) => fn());
    cleanups = [];
  });
</script>

<style>
  .wc {
    --wc-w: clamp(260px, 30vw, 440px);
  }
  .wc__bar {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: clamp(1.5rem, 4vh, 2.5rem);
  }
  /* Contador grande: el número activo rueda hacia arriba */
  .wc__count {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
    /* Números del mismo ancho: el «/ 17» no se separa según el número que se vea */
    font-variant-numeric: tabular-nums;
  }
  .wc__digits {
    display: inline-block;
    height: 1em;
    overflow: hidden;
    font-size: clamp(2.5rem, 5vw, 4.5rem);
  }
  .wc__roll {
    display: grid;
  }
  .wc__roll > :global(span) {
    display: block;
    height: 1em;
  }
  .wc__total {
    font-size: clamp(1.1rem, 2vw, 1.6rem);
    color: var(--muted);
  }
  .wc__nav {
    display: flex;
    gap: 0.5rem;
  }
  .wc__btn {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
    transition:
      background var(--dur-fast),
      color var(--dur-fast),
      border-color var(--dur-fast),
      transform var(--dur-base) var(--ease-out-expo),
      opacity var(--dur-fast);
  }
  .wc__btn:disabled {
    opacity: 0.35;
    cursor: default;
  }
  .wc__btn:focus-visible {
    outline: 2px solid var(--link);
    outline-offset: 3px;
  }
  @media (hover: hover) {
    .wc__btn:not(:disabled):hover {
      background: var(--accent);
      border-color: var(--accent);
      color: var(--accent-ink);
      transform: scale(0.92);
    }
  }

  /* La fila: de borde a borde; la tarjeta activa empieza donde empieza el contenido de la web */
  .wc__track {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
    column-gap: clamp(1rem, 2vw, 1.75rem);
    overflow: hidden;
    cursor: grab;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }
  .wc__track:active {
    cursor: grabbing;
  }
  .wc.is-ready .wc__slide {
    position: absolute;
    top: 0;
    left: max(var(--gutter), calc((100% - 1320px) / 2));
  }
  .wc__slide {
    width: var(--wc-w);
    opacity: 0.3;
    transition: opacity 0.5s var(--ease-out-expo);
    will-change: transform;
  }
  .wc__slide[data-active] {
    opacity: 1;
  }
  .wc__link {
    display: grid;
    gap: 1.1rem;
    text-decoration: none;
    color: inherit;
    -webkit-user-drag: none;
  }
  .wc__link:focus-visible {
    outline: 2px solid var(--link);
    outline-offset: 4px;
    border-radius: 18px;
  }
  .wc__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 11;
    border-radius: 18px;
    border: 1px solid var(--line);
    background: var(--surface);
    box-shadow: var(--card-shadow);
  }
  .wc__img {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    pointer-events: none;
    transition: transform var(--dur-slow) var(--ease-out-expo);
  }
  .wc__media--contain .wc__img {
    object-fit: contain;
    object-position: center;
    padding: 7%;
  }
  .wc__media--contain .wc__img--paper {
    width: 86%;
    height: 86%;
    margin: 7%;
    padding: 0;
    background: #fff;
  }
  .wc__backdrop {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(28px) saturate(1.2);
    transform: scale(1.3);
    opacity: 0.55;
    pointer-events: none;
  }

  /* Texto: solo la activa; entra desde la izquierda con un poco de retraso */
  .wc__caption {
    display: grid;
    gap: 0.6rem;
    justify-items: start;
    padding-inline: 0.25rem;
  }
  .wc.is-ready .wc__caption {
    opacity: 0;
    transform: translateX(-12%);
    transition:
      opacity 0.5s var(--ease-out-expo),
      transform 0.5s var(--ease-out-expo);
  }
  .wc.is-ready .wc__slide[data-active] .wc__caption {
    opacity: 1;
    transform: none;
    transition-delay: 0.2s;
  }
  .wc__tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
  }
  .wc__tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    color: var(--muted);
  }
  .wc__tag--accent {
    border-color: var(--accent);
    color: var(--text);
  }
  .wc__year {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: var(--text-step--1);
    color: var(--muted);
  }
  .wc__title {
    font-size: var(--text-step-2);
    line-height: 1.05;
  }
  .wc__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 600;
    font-size: var(--text-step--1);
    color: var(--link);
  }
  @media (hover: hover) {
    .wc__slide[data-active] .wc__link:hover .wc__img {
      transform: scale(1.04);
    }
  }
  @media (max-width: 767px) {
    .wc {
      --wc-w: min(78vw, 340px);
    }
    .wc__btn {
      width: 44px;
      height: 44px;
    }
  }

  /* Sin JavaScript: fila con scroll horizontal y todas las tarjetas a la vista */
  .wc:not(.is-ready) .wc__track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-inline: max(var(--gutter), calc((100% - 1320px) / 2));
    padding-bottom: 1rem;
    cursor: auto;
  }
  .wc:not(.is-ready) .wc__slide {
    flex: 0 0 auto;
    opacity: 1;
    scroll-snap-align: start;
  }
  .wc:not(.is-ready) .wc__count,
  .wc:not(.is-ready) .wc__nav {
    display: none;
  }
</style>
