---
// Ícono «de app» animado al estilo de resend.com, encima del título de una sección, en los dos temas
// (estilos en skin-resend.css; sin ese estilo queda oculto).
// El color de la luz NO va aquí: lo toma de la sección (--rs-c en skin-resend.css), así cada color se
// cambia en un solo sitio. Animación: el trazo se dibuja al entrar en pantalla (clase .is-in, la pone
// site.ts por data-reveal) y después cada ícono tiene su propio movimiento en bucle.
// Siguiente paso posible (decisión de Willder, 2026-11-18): cambiarlos por videos 3D renderizados.
interface Props {
  icon: "code" | "layers" | "chart" | "spark" | "route" | "chat";
}
const { icon } = Astro.props;
---

<span class="rs-tile" data-icon={icon} data-reveal aria-hidden="true">
  <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    {
      icon === "code" && (
        <>
          <path class="rs-a" pathLength="100" d="M8.5 7.5 4 12l4.5 4.5" />
          <path class="rs-b" pathLength="100" d="M15.5 7.5 20 12l-4.5 4.5" />
          <path class="rs-c" pathLength="100" d="M13.5 5l-3 14" />
        </>
      )
    }
    {
      icon === "layers" && (
        <>
          <path class="rs-a" pathLength="100" d="M12 3.5 3.5 8 12 12.5 20.5 8 12 3.5Z" />
          <path class="rs-b" pathLength="100" d="M3.5 12 12 16.5 20.5 12" />
          <path class="rs-c" pathLength="100" d="M3.5 16 12 20.5 20.5 16" />
        </>
      )
    }
    {
      icon === "chart" && (
        <>
          <path class="rs-base" pathLength="100" d="M3.5 20.5h17" />
          <path class="rs-a" pathLength="100" d="M7 17.5V12" />
          <path class="rs-b" pathLength="100" d="M12 17.5V7" />
          <path class="rs-c" pathLength="100" d="M17 17.5V4" />
        </>
      )
    }
    {
      icon === "spark" && (
        <>
          <path class="rs-a" pathLength="100" d="M12 3c.6 4.6 2.4 6.4 7 7-4.6.6-6.4 2.4-7 7-.6-4.6-2.4-6.4-7-7 4.6-.6 6.4-2.4 7-7Z" />
          <path class="rs-b" pathLength="100" d="M19 15.5c.2 1.6.9 2.3 2.5 2.5-1.6.2-2.3.9-2.5 2.5-.2-1.6-.9-2.3-2.5-2.5 1.6-.2 2.3-.9 2.5-2.5Z" />
        </>
      )
    }
    {
      icon === "route" && (
        <>
          {/* Ruta (How it works; rediseñada el 2026-11-18 a pedido de Willder: la anterior era un trazo corto
              que no llenaba el cuadro). Un camino en curvas que sube del punto de partida (abajo a la
              izquierda) a la meta (arriba a la derecha), como los pasos de la sección. El punto de luz recorre
              el camino y, al llegar, se apaga y el círculo de la meta se llena. El punto y el relleno van con
              SMIL y el mismo dur/keyTimes, así llegan juntos (con CSS no se podrían sincronizar) */}
          <circle class="rs-b" cx="4.5" cy="18.5" r="1.6" />
          <path id="rs-route-path" class="rs-a" pathLength="100" d="M6.1 18.5H14.5a3.25 3.25 0 0 0 0-6.5H8.5a3.25 3.25 0 0 1 0-6.5H17.5" />
          <circle class="rs-c" cx="19.1" cy="5.5" r="1.6" />
          <circle class="rs-fill" cx="19.1" cy="5.5" r="0" fill="currentColor" stroke="none">
            <animate attributeName="r" dur="3.6s" repeatCount="indefinite" values="0;0;1.6;1.6;0" keyTimes="0;0.74;0.8;0.95;1" />
          </circle>
          <circle class="rs-dot" r="1.25" fill="currentColor" stroke="none">
            <animateMotion dur="3.6s" repeatCount="indefinite" keyPoints="0;1;1" keyTimes="0;0.75;1" calcMode="spline" keySplines="0.45 0 0.35 1;0 0 1 1">
              <mpath href="#rs-route-path" />
            </animateMotion>
            <animate attributeName="fill-opacity" dur="3.6s" repeatCount="indefinite" values="1;1;0;0;1" keyTimes="0;0.75;0.79;0.98;1" />
          </circle>
        </>
      )
    }
    {
      icon === "chat" && (
        <>
          <path class="rs-a" pathLength="100" d="M4 6.5A2.5 2.5 0 0 1 6.5 4h11A2.5 2.5 0 0 1 20 6.5v7a2.5 2.5 0 0 1-2.5 2.5H10l-4.5 4v-4h0A1.5 1.5 0 0 1 4 14.5v-8Z" />
          <circle class="rs-d1" cx="8.5" cy="10" r="1" fill="currentColor" stroke="none" />
          <circle class="rs-d2" cx="12" cy="10" r="1" fill="currentColor" stroke="none" />
          <circle class="rs-d3" cx="15.5" cy="10" r="1" fill="currentColor" stroke="none" />
        </>
      )
    }
  </svg>
</span>
