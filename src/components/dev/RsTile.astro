---
// PRUEBA (rama prueba-resend): ícono «de app» al estilo de resend.com, encima del título de una sección.
// Solo se ve con el estilo Resend puesto (skin-resend.css); con «Actual» queda oculto.
interface Props {
  icon: "code" | "spark" | "layers" | "chat";
  /** Tono HSL de la luz de color debajo, p. ej. "28 100% 60%" (naranja) */
  hue: string;
}
const { icon, hue } = Astro.props;
const paths = {
  code: "M8 8 4 12l4 4M16 8l4 4-4 4M13.5 5l-3 14",
  spark: "M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5 18 18M6 18l2.5-2.5M15.5 8.5 18 6",
  layers: "M12 3 3 8l9 5 9-5-9-5ZM3 13l9 5 9-5M3 17.5l9 5 9-5",
  chat: "M4 5h16v11H9l-5 4V5Z M8 9.5h8 M8 12.5h5",
};
---

<span class="rs-tile" style={`--hue:${hue}`} aria-hidden="true">
  <svg viewBox="0 0 24 24" width="28" height="28">
    <path d={paths[icon]} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
</span>
