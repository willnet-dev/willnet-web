---
// PRUEBA (rama prueba-resend): botonera flotante para comparar el estilo actual con el inspirado en
// resend.com. Guarda la elección en localStorage («skin»); el script de tema de Base.astro la aplica
// antes de pintar. No va a main.
---

<div class="skin-switch" role="group" aria-label="Estilo de prueba" data-skin-switch>
  <button type="button" data-skin-set="actual">Actual</button>
  <button type="button" data-skin-set="resend">Resend</button>
  <button type="button" data-skin-set="resend-lima">Resend + lima</button>
</div>

<script>
  const KEY = "skin";

  function sync() {
    const current = document.documentElement.dataset.skin;
    document.querySelectorAll<HTMLButtonElement>("[data-skin-set]").forEach((b) => {
      b.setAttribute("aria-pressed", String(b.dataset.skinSet === current));
    });
  }

  // Tarjetas «iluminadas»: las que usan la sombra de tarjeta (filo de luz arriba) o el fondo de tarjeta,
  // sin imagen de fondo propia. La luz sigue al puntero dentro de cada una.
  function markCards() {
    const surface = getComputedStyle(document.documentElement).getPropertyValue("--surface").trim();
    document.querySelectorAll<HTMLElement>("main *, .stage *").forEach((el) => {
      if (el.classList.contains("rs-glow")) return;
      const s = getComputedStyle(el);
      const isCard = s.boxShadow.includes("inset") || (surface && s.backgroundColor === toRgb(surface));
      if (isCard && s.backgroundImage === "none" && parseFloat(s.borderTopLeftRadius) >= 8 && el.offsetWidth > 120) {
        el.classList.add("rs-glow");
      }
    });
  }

  function toRgb(hex: string) {
    const m = hex.replace("#", "");
    if (m.length !== 6) return "";
    const n = parseInt(m, 16);
    return `rgb(${(n >> 16) & 255}, ${(n >> 8) & 255}, ${n & 255})`;
  }

  function init() {
    sync();
    // Se marca con el estilo Resend puesto, porque cambia la sombra de las tarjetas
    if (document.documentElement.dataset.skin?.startsWith("resend")) requestAnimationFrame(markCards);
  }

  document.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-skin-set]");
    if (!btn) return;
    const skin = btn.dataset.skinSet!;
    document.documentElement.dataset.skin = skin;
    try {
      localStorage.setItem(KEY, skin);
    } catch {}
    init();
  });

  document.addEventListener("pointermove", (e) => {
    const card = (e.target as HTMLElement).closest?.<HTMLElement>(".rs-glow");
    if (!card) return;
    const r = card.getBoundingClientRect();
    card.style.setProperty("--mx", `${e.clientX - r.left}px`);
    card.style.setProperty("--my", `${e.clientY - r.top}px`);
  });

  document.addEventListener("astro:page-load", init);
</script>

<style>
  .skin-switch {
    position: fixed;
    /* Arriba al centro, bajo la cabecera: abajo están WhatsApp (izquierda) y «Volver arriba» (derecha) */
    left: 50%;
    top: calc(var(--header-h) + 0.5rem);
    translate: -50% 0;
    z-index: 60;
    display: flex;
    gap: 2px;
    padding: 3px;
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: 12px;
    background: rgb(10 10 11 / 0.8);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    font: 500 12px/1 var(--font-sans);
    color: #d0d2d4;
  }
  .skin-switch button {
    min-height: 32px;
    padding: 0 0.7rem;
    border-radius: 9px;
    cursor: pointer;
    white-space: nowrap;
  }
  .skin-switch button[aria-pressed="true"] {
    background: #f0f0f0;
    color: #000;
  }
  :global([data-theme="light"]) .skin-switch {
    background: rgb(255 255 255 / 0.85);
    border-color: rgb(0 0 0 / 0.12);
    color: #1c1d20;
  }
  :global([data-theme="light"]) .skin-switch button[aria-pressed="true"] {
    background: #1c1d20;
    color: #fff;
  }
</style>
