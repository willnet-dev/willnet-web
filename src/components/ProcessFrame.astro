---
// Marco de navegador que muestra el estado del proceso (opción B):
// 1 conversación · 2 presupuesto sobre el wireframe · 3 diseño con comentarios · 4 publicado.
// El estado cambia con data-state; el 0 (solo en el marco fijo, antes de verlo) deja el chat vacío
// para que los mensajes entren uno por uno (Willder, 2026-10-31).
import { formatPrice, getService } from "../data/services";

interface Props {
  state?: 1 | 2 | 3 | 4;
  live?: boolean;
  lang: "en" | "es";
}
const { state = 1, live = false, lang } = Astro.props;
const es = lang === "es";
// El presupuesto de ejemplo usa el precio «desde» de una web de negocio (src/data/services.ts)
const quote = getService("websites").price;
---

<div class="pframe browser" data-state={state} {...(live ? { "data-process-frame": "" } : {})} aria-hidden="true">
  <div class="browser__bar">
    <span class="browser__dot"></span><span class="browser__dot"></span><span class="browser__dot"></span>
    <span class="browser__url">
      <span class="pframe__url-draft">draft.willnet.dev/{es ? "tu-negocio" : "your-business"}</span>
      <span class="pframe__url-live">https://{es ? "tunegocio" : "yourbusiness"}.com</span>
    </span>
    <span class="pframe__live">LIVE</span>
  </div>
  <div class="pframe__body">
    <!-- 1 · Conversación -->
    <div class="pframe__chat">
      <p class="bubble bubble--them">{es ? "Hola Will, necesito una web para mi negocio 👋" : "Hi Will, I need a website for my business 👋"}</p>
      <p class="bubble bubble--me">{es ? "¡Claro! Cuéntame qué vendes y a quién." : "Sure! Tell me what you sell and to whom."}</p>
      <p class="bubble bubble--them bubble--typing"><span></span><span></span><span></span></p>
    </div>
    <!-- 2 y 3 · Wireframe que se convierte en diseño -->
    <div class="pframe__page">
      <div class="pf-nav"><span class="pf-logo"></span><span class="pf-links"><i></i><i></i><i></i></span></div>
      <div class="pf-hero">
        <div class="pf-copy">
          <span class="pf-h">{es ? "Tu negocio, en línea." : "Your business, online."}</span>
          <span class="pf-line"></span>
          <span class="pf-line pf-line--short"></span>
          <span class="pf-btn">{es ? "Pide presupuesto" : "Get a quote"}</span>
        </div>
        <div class="pf-img"></div>
      </div>
      <div class="pf-cards"><span></span><span></span><span></span></div>
    </div>
    <!-- 2 · Presupuesto: la propuesta entra sobre el boceto, línea por línea, y se sella -->
    <div class="pf-quote">
      <span class="pf-quote__stamp">{es ? "Aprobado" : "Approved"}</span>
      <p class="pf-quote__ref">{es ? "Propuesta" : "Proposal"} · #0142</p>
      <p class="pf-quote__title">{es ? "Web para tu negocio" : "Website for your business"}</p>
      <ul>
        <li><span>{es ? "Diseño + 5 páginas" : "Design + 5 pages"}</span><i class="pf-check"></i></li>
        <li><span>{es ? "Formulario y WhatsApp" : "Form + WhatsApp"}</span><i class="pf-check"></i></li>
        <li><span>{es ? "Lista en" : "Ready in"}</span><span>{es ? "3 semanas" : "3 weeks"}</span></li>
        <li class="pf-quote__total"><span>Total</span><span data-quote-total={quote}>{formatPrice(quote)}</span></li>
      </ul>
    </div>
    <!-- 3 · Revisión: comentarios del cliente sobre el diseño -->
    <span class="pf-pin pf-pin--a">{es ? "¿Logo más grande?" : "Bigger logo?"}</span>
    <span class="pf-pin pf-pin--b">✓ {es ? "¡Me encanta!" : "Love it!"}</span>
    <span class="pframe__badge">{es ? "30 días de soporte" : "30 days support"}</span>
  </div>
</div>

<style>
  .pframe__body {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    /* La tarjeta y los comentarios miden su letra con el ancho del marco (cqi) */
    container-type: inline-size;
  }
  .pframe .browser__url {
    position: relative;
  }
  .pframe__url-live,
  .pframe__live,
  .pframe__badge {
    opacity: 0;
    transition: opacity var(--dur-base), transform var(--dur-base) var(--ease-out-expo);
  }
  .pframe__url-live {
    position: absolute;
    left: 0.75rem;
    top: 0.25rem;
    color: var(--text);
  }
  .pframe__live {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-ink);
    transform: scale(0.6);
  }
  .pframe__badge {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    border: 1px solid var(--accent);
    color: var(--text);
    background: var(--surface);
    transform: translateY(10px);
  }

  .pframe__chat {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.6rem;
    padding: 1.2rem 1.4rem;
    transition: opacity var(--dur-base), transform var(--dur-base) var(--ease-out-expo);
  }
  .bubble {
    max-width: 75%;
    padding: 0.55rem 0.85rem;
    border-radius: 14px;
    font-size: clamp(0.72rem, 0.6rem + 0.4vw, 0.9rem);
    line-height: 1.35;
    transition:
      opacity var(--dur-base),
      transform var(--dur-base) var(--ease-out-expo);
  }
  /* Antes de ver el marco los mensajes esperan; al llegar al paso 1 entran uno tras otro */
  [data-state="0"] .bubble {
    opacity: 0;
    transform: translateY(10px);
  }
  [data-state="1"] .bubble:nth-child(2) {
    transition-delay: 350ms;
  }
  [data-state="1"] .bubble:nth-child(3) {
    transition-delay: 700ms;
  }
  .bubble--them {
    align-self: flex-start;
    background: var(--surface-2);
    border-bottom-left-radius: 4px;
  }
  .bubble--me {
    align-self: flex-end;
    background: var(--accent);
    color: var(--accent-ink);
    border-bottom-right-radius: 4px;
  }
  .bubble--typing {
    display: inline-flex;
    gap: 4px;
  }
  .bubble--typing span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--muted);
    animation: nudge 1.2s infinite;
  }
  .bubble--typing span:nth-child(2) {
    animation-delay: 0.15s;
  }
  .bubble--typing span:nth-child(3) {
    animation-delay: 0.3s;
  }

  .pframe__page {
    position: absolute;
    inset: 0;
    padding: 0.9rem 1.1rem;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 0.8rem;
    opacity: 0;
    transform: translateY(14px);
    transition: opacity var(--dur-base), transform var(--dur-base) var(--ease-out-expo);
  }
  .pf-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .pf-logo {
    width: 18%;
    height: 10px;
  }
  .pf-links {
    display: flex;
    gap: 6px;
  }
  .pf-links i {
    width: 28px;
    height: 7px;
  }
  .pf-hero {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 0.8rem;
    align-items: center;
  }
  .pf-copy {
    display: grid;
    gap: 0.45rem;
    justify-items: start;
  }
  .pf-h {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(0.8rem, 0.5rem + 1vw, 1.35rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: transparent;
    min-height: 2.1em;
    width: 100%;
  }
  .pf-line {
    width: 90%;
    height: 7px;
  }
  .pf-line--short {
    width: 60%;
  }
  .pf-btn {
    margin-top: 0.3rem;
    font-size: clamp(0.6rem, 0.5rem + 0.3vw, 0.75rem);
    font-weight: 600;
    padding: 0.4em 0.9em;
    border-radius: 999px;
    color: transparent;
  }
  .pf-img {
    aspect-ratio: 4 / 3;
  }
  .pf-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
  }
  .pf-cards span {
    height: clamp(26px, 4vw, 48px);
  }

  /* Estado 2: wireframe (líneas punteadas) */
  .pf-logo,
  .pf-links i,
  .pf-h,
  .pf-line,
  .pf-btn,
  .pf-img,
  .pf-cards span {
    border: 1.5px dashed var(--wire);
    border-radius: 5px;
    background: transparent;
    transition:
      background var(--dur-slow) var(--ease-out-expo),
      border-color var(--dur-slow),
      color var(--dur-slow);
  }

  [data-state="1"] .pframe__chat {
    opacity: 1;
  }
  [data-state="2"] .pframe__chat,
  [data-state="3"] .pframe__chat,
  [data-state="4"] .pframe__chat {
    opacity: 0;
    transform: translateY(-14px);
  }
  [data-state="2"] .pframe__page,
  [data-state="3"] .pframe__page,
  [data-state="4"] .pframe__page {
    opacity: 1;
    transform: none;
  }
  /* En el presupuesto el boceto queda detrás, más tenue */
  [data-state="2"] .pframe__page {
    opacity: 0.35;
  }

  /* Estado 2: tarjeta de propuesta */
  .pf-quote {
    position: absolute;
    inset: 0;
    margin: auto;
    width: min(64%, 320px);
    height: fit-content;
    padding: 0.9em 1.1em;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
    box-shadow: 0 18px 40px -18px rgb(0 0 0 / 0.35);
    font-size: clamp(0.6rem, 2.5cqi, 0.9rem);
    line-height: 1.3;
    opacity: 0;
    transform: translateY(18%) rotate(3deg);
    transition:
      opacity var(--dur-base),
      transform var(--dur-slow) var(--ease-out-expo);
  }
  .pf-quote__ref {
    font-family: var(--font-mono);
    font-size: 0.8em;
    color: var(--muted);
  }
  .pf-quote__title {
    margin: 0.15em 0 0.5em;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .pf-quote li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1em;
    padding: 0.35em 0;
    border-bottom: 1px solid var(--line);
    opacity: 0;
    transform: translateX(-8px);
    transition:
      opacity var(--dur-base),
      transform var(--dur-base) var(--ease-out-expo);
  }
  .pf-quote .pf-quote__total {
    border-bottom: 0;
    font-weight: 600;
  }
  .pf-check {
    flex: none;
    width: 1.15em;
    height: 1.15em;
    border-radius: 50%;
    background: var(--accent);
    position: relative;
  }
  .pf-check::after {
    content: "";
    position: absolute;
    left: 38%;
    top: 22%;
    width: 25%;
    height: 45%;
    border: solid var(--accent-ink);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }
  .pf-quote__stamp {
    position: absolute;
    right: -0.8em;
    top: -0.9em;
    padding: 0.2em 0.6em;
    border: 2px solid var(--accent-ink);
    border-radius: 6px;
    background: var(--accent);
    color: var(--accent-ink);
    font-family: var(--font-mono);
    font-size: 0.8em;
    font-weight: 600;
    text-transform: uppercase;
    opacity: 0;
    transform: rotate(-10deg) scale(1.8);
    transition:
      opacity 0.2s,
      transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  [data-state="2"] .pf-quote,
  [data-state="2"] .pf-quote li {
    opacity: 1;
    transform: none;
  }
  [data-state="2"] .pf-quote li:nth-child(1) {
    transition-delay: 200ms;
  }
  [data-state="2"] .pf-quote li:nth-child(2) {
    transition-delay: 330ms;
  }
  [data-state="2"] .pf-quote li:nth-child(3) {
    transition-delay: 460ms;
  }
  [data-state="2"] .pf-quote li:nth-child(4) {
    transition-delay: 590ms;
  }
  [data-state="2"] .pf-quote__stamp {
    opacity: 1;
    transform: rotate(-10deg) scale(1);
    transition-delay: 1.5s;
  }
  /* Aprobada, la tarjeta sale hacia arriba y deja ver el diseño */
  :is([data-state="3"], [data-state="4"]) .pf-quote {
    transform: translateY(-14%) scale(0.96);
  }

  /* Estado 3: comentarios de revisión */
  .pf-pin {
    position: absolute;
    padding: 0.35em 0.75em;
    border-radius: 10px 10px 10px 2px;
    background: var(--text);
    color: var(--bg);
    font-size: clamp(0.55rem, 2.2cqi, 0.8rem);
    font-weight: 500;
    white-space: nowrap;
    opacity: 0;
    scale: 0.6;
    transform-origin: 0 100%;
    transition:
      opacity 0.25s,
      scale 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .pf-pin--a {
    left: 16%;
    top: 4%;
  }
  .pf-pin--b {
    left: 22%;
    top: 66%;
  }
  [data-state="3"] .pf-pin {
    opacity: 1;
    scale: 1;
    transition-delay: 450ms;
  }
  [data-state="3"] .pf-pin--b {
    transition-delay: 800ms;
  }

  /* Estado 3 y 4: diseño terminado */
  :is([data-state="3"], [data-state="4"]) :is(.pf-logo, .pf-links i, .pf-line, .pf-cards span) {
    border-color: transparent;
    background: var(--surface-2);
  }
  :is([data-state="3"], [data-state="4"]) .pf-logo {
    background: var(--text);
  }
  :is([data-state="3"], [data-state="4"]) .pf-h {
    border-color: transparent;
    color: var(--text);
  }
  :is([data-state="3"], [data-state="4"]) .pf-btn {
    border-color: transparent;
    background: var(--accent);
    color: var(--accent-ink);
  }
  :is([data-state="3"], [data-state="4"]) .pf-img {
    border-color: transparent;
    background:
      radial-gradient(circle at 70% 30%, color-mix(in oklab, var(--accent) 70%, transparent) 0 18%, transparent 19%),
      linear-gradient(135deg, var(--surface-2), color-mix(in oklab, var(--text) 18%, var(--surface-2)));
  }
  [data-state="4"] .pframe__url-draft {
    opacity: 0;
  }
  [data-state="4"] :is(.pframe__url-live, .pframe__live, .pframe__badge) {
    opacity: 1;
    transform: none;
  }
  /* Al publicar, LIVE y el soporte entran con un pequeño rebote */
  [data-state="4"] :is(.pframe__live, .pframe__badge) {
    transition-timing-function: ease, cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  [data-state="4"] .pframe__badge {
    transition-delay: 300ms;
  }
</style>
