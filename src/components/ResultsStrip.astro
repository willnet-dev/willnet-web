---
// Portada: franja «Resultados medidos» con las cifras de esta misma web (Lighthouse en celular), de
// src/data/results.ts. Las cifras de los clientes van en la página de cada caso («metrics» de su JSON).
// Los números cuentan al entrar en pantalla (site.ts → data-count); el HTML ya trae el valor final.
import type { Lang } from "../i18n/routes";
import { t } from "../i18n/ui";
import { selfResults } from "../data/results";
import { formatNumber } from "../lib/format";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const h = t(lang).home;
---

<section class="wrap py-[clamp(4rem,10vh,8rem)]" aria-labelledby="results-title">
  <div class="mb-12 grid gap-6 lg:grid-cols-[1fr_1fr] lg:items-end">
    <div>
      <p class="eyebrow mb-4" data-reveal>{h.resultsEyebrow}</p>
      <h2 id="results-title" class="display max-w-[16ch] text-[length:var(--text-step-4)]" data-reveal>{h.resultsTitle}</h2>
    </div>
    <p class="max-w-[46ch] text-[length:var(--text-step-1)] text-muted" data-reveal>{h.resultsText}</p>
  </div>
  <dl class="results">
    {
      selfResults.map((r, i) => (
        <div class="result" data-reveal style={`--delay:${i * 80}ms`}>
          <dt class="sr-only">{h.resultsLabels[r.id]}</dt>
          <dd class="result__num">
            <span data-count={r.value}>{formatNumber(r.value, lang)}</span>
            <span class="result__unit">{r.unit}</span>
          </dd>
          <dd class="result__label" aria-hidden="true">
            {h.resultsLabels[r.id]}
          </dd>
          <dd class="result__src eyebrow" aria-hidden="true">
            willnet.dev · Lighthouse
          </dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .results {
    display: grid;
    border-top: 1px solid var(--line);
  }
  @media (min-width: 640px) {
    .results {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .results {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .result {
    display: flex;
    flex-direction: column;
    padding: 2rem 1.5rem 2rem 0;
    border-bottom: 1px solid var(--line);
  }
  .result__num {
    display: flex;
    align-items: baseline;
    gap: 0.2em;
    font-family: var(--font-display);
    font-size: var(--text-step-5);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .result__unit {
    font-size: 0.4em;
    /* Gris de texto (no el de los wireframes) para que también cumpla el contraste mínimo */
    color: var(--muted);
  }
  .result__label {
    margin-top: 1rem;
    max-width: 24ch;
    color: var(--muted);
  }
  .result__src {
    margin-top: auto;
    padding-top: 1.5rem;
  }
  /* En 4 columnas «100/100» llenaba la columna entera: el número escala con el ancho y deja aire
     (va al final para ganarle a la regla base de .result__num) */
  @media (min-width: 1024px) {
    .result__num {
      font-size: min(var(--text-step-5), 5.4vw);
    }
  }
</style>
