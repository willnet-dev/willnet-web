---
// Botón flotante de WhatsApp abajo a la izquierda (como en la landing actual). Oscuro con el ícono lima
// en los dos temas (decisiones de Willder, 2026-10-26):
// - Escritorio: entra con un rebote (solo la primera vez en la sesión), el ícono se mueve de vez en cuando,
//   es magnético y al pasar el mouse se abre con el texto.
// - Móvil: solo un pulso cada 4,5 s.
import Icon from "./Icon.astro";
import type { Lang } from "../i18n/routes";
import { t, whatsappHref } from "../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = t(lang);
---

<div class="wa-fab-wrap" data-wa-fab>
  <a href={whatsappHref(lang)} target="_blank" rel="noopener" class="wa-fab" data-magnetic data-magnetic-strength="0.35">
    <Icon name="whatsapp" size={24} class="wa-fab__icon" />
    <span class="wa-fab__label">{copy.cta.whatsappFab}</span>
  </a>
</div>

<style>
  .wa-fab-wrap {
    position: fixed;
    left: max(1rem, env(safe-area-inset-left));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 40;
  }
  .wa-fab {
    position: relative;
    display: flex;
    align-items: center;
    height: 52px;
    padding-inline: 13px;
    border-radius: 999px;
    border: 1px solid #2a2a2e;
    background: #141416;
    color: #d4ff3a;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.35);
    text-decoration: none;
    transition: border-color var(--dur-base) var(--ease-out-expo);
  }
  .wa-fab :global(.wa-fab__icon) {
    flex-shrink: 0;
    transition: transform var(--dur-base) var(--ease-out-expo);
  }
  .wa-fab__label {
    max-width: 0;
    overflow: hidden;
    white-space: nowrap;
    opacity: 0;
    color: #f4f4f2;
    font-weight: 600;
    font-size: var(--text-step--1);
    transition:
      max-width 500ms var(--ease-out-expo),
      margin 500ms var(--ease-out-expo),
      opacity 300ms;
  }
  .wa-fab:focus-visible .wa-fab__label {
    max-width: 16rem;
    margin-left: 0.6rem;
    opacity: 1;
  }

  /* Escritorio (mouse): se abre con el texto, entrada con rebote y un pequeño movimiento del ícono */
  @media (hover: hover) and (pointer: fine) {
    .wa-fab:hover {
      border-color: #d4ff3a;
    }
    .wa-fab:hover .wa-fab__label {
      max-width: 16rem;
      margin-left: 0.6rem;
      opacity: 1;
    }
    .wa-fab:hover :global(.wa-fab__icon) {
      transform: rotate(-12deg) scale(1.08);
    }
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    /* html.wa-seen lo pone el script del <head> cuando ya se vio la entrada en esta sesión */
    :global(html:not(.wa-seen)) .wa-fab-wrap {
      animation: waIn 900ms cubic-bezier(0.34, 1.56, 0.64, 1) 1s both;
    }
    .wa-fab :global(.wa-fab__icon) {
      animation: waWiggle 7s ease-in-out 3s infinite;
    }
  }
  @keyframes waIn {
    from {
      opacity: 0;
      transform: translateY(28px) scale(0.6);
    }
  }
  @keyframes waWiggle {
    0%,
    86%,
    100% {
      rotate: 0deg;
    }
    88% {
      rotate: -16deg;
    }
    91% {
      rotate: 13deg;
    }
    94% {
      rotate: -8deg;
    }
    97% {
      rotate: 4deg;
    }
  }

  /* Móvil (táctil): solo un pulso cada 4,5 s */
  @media (hover: none) and (prefers-reduced-motion: no-preference) {
    .wa-fab::after {
      content: "";
      position: absolute;
      inset: -1px;
      border-radius: inherit;
      border: 2px solid #d4ff3a;
      pointer-events: none;
      animation: waPulse 4.5s ease-out infinite;
    }
  }
  @keyframes waPulse {
    0% {
      opacity: 0.8;
      transform: scale(1);
    }
    30%,
    100% {
      opacity: 0;
      transform: scale(1.7);
    }
  }
</style>
