---
// Pantalla de carga de la web (idea de osmo.supply, «Willem Loading Animation», escrita desde cero).
// Sale solo la primera vez que se abre el sitio en la pestaña (sessionStorage «loader-seen», ver Base.astro),
// nunca al cambiar de página, ni con «reducir movimiento» ni sin JavaScript.
// Secuencia (site.ts → initLoader):
//   1. Suben las letras de WILL y NET.
//   2. Entre las dos se abre una ventana con capturas de proyectos reales que se van quitando una a una.
//   3. Debajo de la última ya está la web de verdad, en miniatura: la ventana es un hueco en la pantalla de carga
//      (el fondo oscuro es la sombra de la ventana) y <body> se escala para llenarla.
//   4. Tras una pausa corta, la ventana crece hasta llenar la pantalla, la web crece con ella y empuja las letras.
// Miniaturas: public/img/loader/*.webp, creadas con `npm run loader-images`.
const extras = ["acl", "imola", "pavlove"];
---

<div class="site-loader" data-site-loader aria-hidden="true">
  <div class="sl__word">
    <div class="sl__row" data-sl-row>
      <span class="sl__half" data-sl-half="start">
        {[..."WILL"].map((l) => <span class="sl__letter" data-sl-letter>{l}</span>)}
      </span>
      <span class="sl__box" data-sl-box>
        <span class="sl__img" data-sl-img>
          {/* La primera de la lista va arriba: se ve primero y es la primera que se quita */}
          {[...extras].reverse().map((slug) => <img class="sl__extra" data-sl-extra src={`/img/loader/${slug}.webp`} width="640" height="480" alt="" decoding="async" />)}
        </span>
      </span>
      <span class="sl__half" data-sl-half="end">
        {[..."NET"].map((l) => <span class="sl__letter" data-sl-letter>{l}</span>)}
      </span>
    </div>
  </div>
</div>

<style>
  .site-loader {
    display: none;
  }
  /* Se ve mientras <html> tiene .js y .is-loading (los pone el script del <head> de Base.astro) y, durante la
     salida, con .is-active (lo pone site.ts): .is-loading se quita cuando la ventana empieza a crecer, para que
     la entrada del hero arranque mientras se descubre */
  :global(html.js.is-loading) .site-loader,
  .site-loader.is-active {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: block;
    overflow: hidden;
    background: var(--bg);
    color: var(--ink);
  }
  /* Sin scroll mientras carga. El hueco de la barra de desplazamiento queda reservado (scrollbar-gutter en
     global.css), así que al quitarlo la página no salta de ancho */
  :global(html.js.is-loading) {
    overflow: hidden;
  }
  /* Hasta que el JavaScript la toma, solo se ve el fondo: así las letras no aparecen y luego saltan abajo.
     Cuando la toma, el fondo pasa a ser la sombra de la ventana (abajo, .sl__img) */
  .site-loader:not(.is-active) .sl__word {
    visibility: hidden;
  }
  .site-loader.is-active {
    background: transparent;
  }
  /* Centrado con position + translate (no con la cuadrícula del contenedor): cuando la ventana crece más que la
     pantalla, la palabra sigue centrada y se desborda por igual a los dos lados */
  .sl__word {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.5rem, 11vw, 10rem);
    line-height: 0.8;
    letter-spacing: -0.04em;
    white-space: nowrap;
  }
  /* La fila que se mueve de lado (site.ts la corre para centrar la ventana). Va dentro de .sl__word y no en
     .sl__word misma: GSAP, al animar x en un elemento que ya tiene la propiedad CSS translate, la absorbe y la
     pasa a píxeles, y la palabra se iba unos 380 px a la derecha (2026-11-18) */
  .sl__row {
    flex: none;
    display: flex;
    align-items: center;
  }
  /* Cada mitad recorta sus letras: suben desde abajo de la línea */
  /* flex: none en las mitades y la ventana: cuando la ventana crece más que la pantalla, nada se encoge y la fila
     se desborda por igual a los dos lados (las letras salen empujadas hacia afuera) */
  .sl__half {
    position: relative;
    z-index: 2;
    flex: none;
    display: flex;
    overflow: hidden;
    padding-block: 0.06em;
  }
  .sl__letter {
    display: block;
  }
  /* La ventana entre WILL y NET: empieza sin ancho y crece; lo de dentro se centra para crecer hacia los lados */
  .sl__box {
    flex: none;
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 0;
    height: 0.8em;
  }
  .sl__img {
    position: relative;
    flex: none;
    width: 0%;
    height: 100%;
    overflow: hidden;
    border-radius: 0.06em;
    /* El hueco: una sombra enorme del color del fondo tapa toda la pantalla menos la ventana, que queda
       transparente y deja ver la página real. Crece con la ventana sin que haya que mover nada más.
       Sin borde: Willder prefirió la ventana limpia (2026-11-18) */
    box-shadow: 0 0 0 200vmax var(--bg);
  }
  .sl__extra {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .sl__extra {
    object-fit: cover;
  }
</style>
