---
// Pantalla de carga de la web (idea de osmo.supply, «Willem Loading Animation», escrita desde cero).
// Sale solo la primera vez que se abre el sitio en la pestaña (sessionStorage «loader-seen», ver Base.astro),
// nunca al cambiar de página, ni con «reducir movimiento» ni sin JavaScript.
// Secuencia (site.ts → initLoader):
//   1. Suben las letras de WILL y NET.
//   2. Entre las dos se abre una ventana con capturas de proyectos reales que se van quitando una a una.
//   3. Debajo de la última ya está la web de verdad, en miniatura: la ventana es un hueco en la pantalla de carga
//      (el fondo oscuro es la sombra de la ventana) y <body> se escala para llenarla.
//   4. Tras una pausa corta, la ventana crece hasta llenar la pantalla, la web crece con ella y empuja las letras.
// Estilo Resend (2026-11-18): las letras llevan el degradado de los títulos (--rs-title) y arriba cae la misma
// luz que en el hero (--rs-hero-a/b, --rs-beam), que se apaga al crecer la ventana. Los colores salen de los
// tokens de skin-resend.css; sin ellos (otra rama), letras del color del texto y sin luz.
// Miniaturas: public/img/loader/*.webp, creadas con `npm run loader-images`.
const extras = ["acl", "imola", "pavlove"];
---

<div class="site-loader" data-site-loader aria-hidden="true">
  {/* El fondo de la pantalla de carga, con la ventana recortada (clip-path, lo dibuja site.ts) */}
  <span class="sl__mask" data-sl-mask></span>
  <div class="sl__word">
    <div class="sl__row" data-sl-row>
      <span class="sl__half" data-sl-half="start">
        {[..."WILL"].map((l) => <span class="sl__letter" data-sl-letter>{l}</span>)}
      </span>
      <span class="sl__box" data-sl-box>
        <span class="sl__img" data-sl-img>
          {/* La primera de la lista va arriba: se ve primero y es la primera que se quita */}
          {[...extras].reverse().map((slug) => <img class="sl__extra" data-sl-extra src={`/img/loader/${slug}.webp`} width="640" height="480" alt="" decoding="async" />)}
        </span>
      </span>
      <span class="sl__half" data-sl-half="end">
        {[..."NET"].map((l) => <span class="sl__letter" data-sl-letter>{l}</span>)}
      </span>
    </div>
  </div>
  <span class="sl__light" data-sl-light></span>
</div>

<style>
  .site-loader {
    display: none;
  }
  /* Se ve mientras <html> tiene .js y .is-loading (los pone el script del <head> de Base.astro) y, durante la
     salida, con .is-active (lo pone site.ts): .is-loading se quita cuando la ventana empieza a crecer, para que
     la entrada del hero arranque mientras se descubre */
  :global(html.js.is-loading) .site-loader,
  .site-loader.is-active {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: block;
    overflow: hidden;
    background: var(--bg);
    color: var(--text);
  }
  /* Sin scroll mientras carga. El hueco de la barra de desplazamiento queda reservado (scrollbar-gutter en
     global.css), así que al quitarlo la página no salta de ancho */
  :global(html.js.is-loading) {
    overflow: hidden;
  }
  /* Hasta que el JavaScript la toma, solo se ve el fondo: así las letras no aparecen y luego saltan abajo.
     Cuando la toma, el fondo pasa a ser la capa .sl__mask, con la ventana recortada */
  .site-loader:not(.is-active) :is(.sl__word, .sl__light) {
    visibility: hidden;
  }
  .site-loader.is-active {
    background: transparent;
  }
  /* Centrado con position + translate (no con la cuadrícula del contenedor): cuando la ventana crece más que la
     pantalla, la palabra sigue centrada y se desborda por igual a los dos lados */
  .sl__word {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.5rem, 11vw, 10rem);
    line-height: 0.8;
    letter-spacing: -0.04em;
    white-space: nowrap;
  }
  /* La fila que se mueve de lado (site.ts la corre para centrar la ventana). Va dentro de .sl__word y no en
     .sl__word misma: GSAP, al animar x en un elemento que ya tiene la propiedad CSS translate, la absorbe y la
     pasa a píxeles, y la palabra se iba unos 380 px a la derecha (2026-11-18) */
  .sl__row {
    flex: none;
    display: flex;
    align-items: center;
  }
  /* Cada mitad recorta sus letras: suben desde abajo de la línea */
  /* flex: none en las mitades y la ventana: cuando la ventana crece más que la pantalla, nada se encoge y la fila
     se desborda por igual a los dos lados (las letras salen empujadas hacia afuera) */
  .sl__half {
    position: relative;
    z-index: 2;
    flex: none;
    display: flex;
    overflow: hidden;
    padding-block: 0.06em;
  }
  /* Degradado de los títulos (blanco → 50 % en oscuro; negro → Toupe Seta en claro), recortado a las letras.
     Mide lo que WILL y NET juntas (--sl-word) y cada letra toma su tramo (--sl-x, su distancia al inicio de WILL;
     los dos los pone site.ts): se lee como un solo degradado aunque la ventana las separe.
     Va en cada letra y no en la mitad: en Safari (iPhone), background-clip: text en un padre no pinta los hijos
     que se mueven con transform, y las letras no se veían (2026-11-18). El alto suma el padding de la mitad
     (0,06 em arriba y abajo) para que el degradado caiga igual que antes */
  .sl__letter {
    display: block;
    background-image: var(--rs-title, linear-gradient(var(--text), var(--text)));
    background-size: var(--sl-word, 100%) calc(100% + 0.12em);
    background-position: calc(-1 * var(--sl-x, 0px)) -0.06em;
    background-repeat: no-repeat;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  /* El hueco entre WILL y NET: empieza sin ancho y crece, y así separa (y al final empuja) las letras. La ventana
     se dibuja centrada en él (site.ts, a partir de su medida en cada fotograma) */
  .sl__box {
    flex: none;
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 0;
    height: 0.8em;
  }
  /* La ventana no cambia de ancho ni de alto: se dibuja recortando (clip-path), que no mueve nada en la página.
     Antes crecía con width/height y Chrome lo contaba como saltos de la página (CLS ≈ 0,45 en Lighthouse,
     2026-11-18). Dos piezas, las dos con medidas fijas:
     - .sl__mask: el fondo a pantalla completa con un hueco del tamaño de la ventana (clip-path: path, evenodd).
     - .sl__img: las capturas, con el tamaño final de la ventana abierta (1 em × 0,8 em), centradas en la caja
       con transform y recortadas al ancho de la ventana (clip-path: inset). Con object-fit: cover la captura
       mide lo mismo que cuando la ventana crecía de verdad: se ve igual.
     Sin borde: Willder prefirió la ventana limpia (2026-11-18) */
  .sl__mask {
    position: absolute;
    inset: 0;
    background: var(--bg);
  }
  .sl__img {
    position: absolute;
    left: 0;
    top: 0;
    width: 1em;
    height: 100%;
    clip-path: inset(0 50%);
  }
  .sl__extra {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .sl__extra {
    object-fit: cover;
  }
  /* La luz del hero (skin-resend.css, [data-hero]): un foco desde arriba y un haz diagonal que respira. Va encima
     del fondo para que caiga también sobre las letras; no recibe clics */
  .sl__light {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      radial-gradient(ellipse 70% 55% at 30% -12%, var(--rs-hero-a, transparent), transparent 70%),
      radial-gradient(ellipse 40% 40% at 85% 10%, var(--rs-hero-b, transparent), transparent 70%);
  }
  .sl__light::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(118deg, transparent 38%, var(--rs-beam, transparent) 47%, var(--rs-beam-2, transparent) 53%, transparent 60%);
    animation: slBeam 9s ease-in-out infinite alternate;
  }
  /* En claro el hero no lleva el haz (skin-resend.css): aquí tampoco, solo el foco de arriba */
  :global(html[data-theme="light"]) .sl__light::after {
    display: none;
  }
  @keyframes slBeam {
    from {
      opacity: 0.55;
      transform: translateX(-4%);
    }
    to {
      opacity: 1;
      transform: translateX(4%);
    }
  }
</style>
