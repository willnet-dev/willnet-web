---
// Proceso de trabajo (opción B). En escritorio, el marco queda fijo a la derecha y se construye
// mientras se leen los 4 pasos. En móvil (o con movimiento reducido), cada paso trae su propio marco.
import ProcessFrame from "./ProcessFrame.astro";
import type { Lang } from "../i18n/routes";
import { t } from "../i18n/ui";

interface Props {
  lang: Lang;
  eyebrow: string;
  title: string;
}
const { lang, eyebrow, title } = Astro.props;
const copy = t(lang);
---

<section class="wrap py-[clamp(5rem,12vh,9rem)]" data-process aria-labelledby="process-title">
  <p class="eyebrow mb-4" data-reveal>{eyebrow}</p>
  <h2 id="process-title" class="display mb-14 max-w-[18ch] text-[length:var(--text-step-4)]" data-reveal>{title}</h2>

  <div class="grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] lg:gap-16">
    <!-- Móvil y tableta: tarjetas de 2 en 2 con el mini wireframe arriba (decisión de Willder, 2026-10-26) -->
    <ol class="grid grid-cols-2 gap-3 md:gap-6 lg:flex lg:flex-col lg:gap-0">
      {
        copy.process.map((step, i) => (
          <li data-process-step={i + 1} class:list={["process-step", { "is-active": i === 0 }]}>
            <div class="process-step__inner">
              <p class="eyebrow">
                // {String(i + 1).padStart(2, "0")} · <b>{step.tag}</b>
              </p>
              <h3 class="display mt-3 text-[length:var(--text-step-3)]">{step.title}</h3>
              <p class="mt-3 max-w-[40ch] text-muted">{step.text}</p>
              <div class="step-frame mt-6">
                <ProcessFrame state={(i + 1) as 1 | 2 | 3 | 4} lang={lang} />
              </div>
            </div>
          </li>
        ))
      }
    </ol>
    <div class="sticky-col">
      <div class="sticky top-[calc(50vh-min(22vw,260px))]">
        <ProcessFrame state={1} live lang={lang} />
      </div>
    </div>
  </div>
</section>

<style>
  .process-step__inner {
    padding: 1.6rem;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: var(--surface);
  }
  @media (max-width: 1023px) {
    .process-step,
    .process-step__inner {
      height: 100%;
    }
    .process-step__inner {
      display: flex;
      flex-direction: column;
    }
    .step-frame {
      order: -1;
      margin: 0 0 1rem;
    }
  }
  @media (max-width: 767px) {
    .process-step__inner {
      padding: 0.9rem;
      border-radius: 16px;
    }
    .process-step__inner h3 {
      margin-top: 0.4rem;
      font-size: var(--text-step-1);
      line-height: 1.15;
      hyphens: auto;
      overflow-wrap: anywhere;
    }
    .process-step__inner p:not(.eyebrow) {
      margin-top: 0.4rem;
      font-size: var(--text-step--1);
      line-height: 1.4;
    }
    .process-step__inner .eyebrow {
      font-size: 0.68rem;
    }
  }
  @media (min-width: 1024px) {
    .process-step {
      min-height: 62vh;
      display: flex;
      align-items: center;
    }
    .process-step__inner {
      padding: 0 0 0 1.6rem;
      border: 0;
      border-left: 2px solid var(--line);
      border-radius: 0;
      background: transparent;
      transition: border-color var(--dur-base);
    }
    /* Pasos inactivos: el título pasa a gris (sin opacidad, para mantener el contraste AA) */
    .process-step__inner h3,
    .process-step__inner .eyebrow b {
      color: var(--muted);
      transition: color var(--dur-base);
    }
    .process-step.is-active .process-step__inner {
      border-left-color: var(--accent);
    }
    .process-step.is-active .process-step__inner h3,
    .process-step.is-active .process-step__inner .eyebrow b {
      color: var(--text);
    }
    :global([data-theme="light"]) .process-step.is-active .process-step__inner {
      border-left-color: var(--text);
    }
  }
  .sticky-col {
    display: none;
  }
  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    .sticky-col {
      display: block;
    }
    .step-frame {
      display: none;
    }
  }
  @media (min-width: 1024px) and (prefers-reduced-motion: reduce) {
    .process-step {
      min-height: 0;
      padding-block: 1.5rem;
    }
    .process-step__inner h3 {
      color: var(--text);
    }
  }
</style>
