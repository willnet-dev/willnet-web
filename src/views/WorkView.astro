---
// Portafolio. Arriba, los casos de estudio en un slider por capas (LayeredSlider.astro; reemplazó a los
// dispositivos 3D el 2026-11-16, pedido de Willder). Abajo, el resto de proyectos con filtros en una fila
// arrastrable sin fin (WorkCarousel.astro, 2026-11-17).
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import WorkCarousel from "../components/WorkCarousel.astro";
import LayeredSlider from "../components/LayeredSlider.astro";
import { r, type Lang } from "../i18n/routes";
import { allWork, inShowcase, sliderItems as toSliderItems } from "../lib/caseSlider";
import { t } from "../i18n/ui";
import { breadcrumbs } from "../lib/schema";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = t(lang);
const p = copy.workPage;
const all = await allWork();
// Slider de arriba: los casos de la vitrina (src/lib/caseSlider.ts, los mismos del inicio). El resto
// (y los casos con inShowcase: false, como Mastermind) va en la fila de abajo
const cases = all.filter(inShowcase);
const rest = all.filter((x) => !inShowcase(x));
const restCats = ["events", "design", "learning"] as const;
const sliderItems = toSliderItems(cases, lang);
---

<Base
  lang={lang}
  title={p.title}
  description={p.description}
  schema={[
    breadcrumbs([
      { name: copy.common.breadcrumbHome, path: r("home", lang) },
      { name: copy.nav.work, path: r("work", lang) },
    ]),
  ]}
>
  <PageHead
    eyebrow={p.eyebrow}
    title={p.h1}
    intro={p.intro}
    crumbs={[
      { name: copy.common.breadcrumbHome, href: r("home", lang) },
      { name: copy.nav.work, href: r("work", lang) },
    ]}
  >
    <p class="eyebrow mt-6"><b>{all.length}</b> {p.count}</p>
  </PageHead>

  <div class="pb-[clamp(4rem,10vh,8rem)]">
    <LayeredSlider lang={lang} items={sliderItems} />
  </div>

  <!-- «All work»: fila arrastrable sin fin (WorkCarousel.astro, pedido de Willder, 2026-11-17; antes era una cuadrícula) -->
  <section class="pb-[clamp(4rem,10vh,8rem)]" aria-labelledby="more-title">
    <div class="wrap mb-8 flex flex-wrap items-end justify-between gap-6 border-t border-line pt-12">
      <h2 id="more-title" class="display text-[length:var(--text-step-3)]">{copy.common.allWork}</h2>
      <div class="flex flex-wrap gap-2" role="group" aria-label={copy.common.allWork} data-filters>
        <button type="button" class="filter" data-filter="all" aria-pressed="true">{p.filters.all}</button>
        {restCats.map((cat) => <button type="button" class="filter" data-filter={cat} aria-pressed="false">{p.filters[cat]}</button>)}
      </div>
    </div>
    <WorkCarousel lang={lang} projects={rest} />
    <p class="wrap eyebrow mt-10" data-learning-note>{p.learningNote}</p>
  </section>
</Base>

<style>
  .filter {
    min-height: 44px;
    padding: 0.5rem 1.1rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    font-weight: 500;
    cursor: pointer;
    transition:
      background var(--dur-fast),
      color var(--dur-fast),
      border-color var(--dur-fast);
  }
  .filter:hover {
    border-color: var(--text);
  }
  .filter[aria-pressed="true"] {
    background: var(--text);
    color: var(--bg);
    border-color: var(--text);
  }
</style>
