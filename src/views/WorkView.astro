---
// Portafolio. Arriba, los casos de estudio en un slider por capas (LayeredSlider.astro; reemplazó a los
// dispositivos 3D el 2026-11-16, pedido de Willder). Abajo, el resto de proyectos con filtros.
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import ProjectCard from "../components/ProjectCard.astro";
import LayeredSlider from "../components/LayeredSlider.astro";
import { r, workPath, type Lang } from "../i18n/routes";
import { t } from "../i18n/ui";
import { breadcrumbs } from "../lib/schema";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = t(lang);
const p = copy.workPage;
const all = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
// Slider de arriba: los casos marcados para la vitrina. El resto (y los casos con
// inShowcase: false, como Mastermind) va en la cuadrícula de abajo
// (!== false: si el campo falta, el caso va en la vitrina, como antes)
const inShowcase = (x: (typeof all)[number]) => x.data.hasCase && x.data.inShowcase !== false;
const cases = all.filter(inShowcase);
const rest = all.filter((x) => !inShowcase(x));
const restCats = ["events", "design", "learning"] as const;

const sliderItems = cases.map((c) => ({
  href: workPath(c.id, lang),
  title: c.data[lang].title,
  type: c.data[lang].type,
  year: c.data.year,
  desktop: lang === "es" ? c.data.image.es : c.data.image.en,
  mobile: lang === "es" ? c.data.image.mobileEs : c.data.image.mobileEn,
}));
---

<Base
  lang={lang}
  title={p.title}
  description={p.description}
  schema={[
    breadcrumbs([
      { name: copy.common.breadcrumbHome, path: r("home", lang) },
      { name: copy.nav.work, path: r("work", lang) },
    ]),
  ]}
>
  <PageHead
    eyebrow={p.eyebrow}
    title={p.h1}
    intro={p.intro}
    crumbs={[
      { name: copy.common.breadcrumbHome, href: r("home", lang) },
      { name: copy.nav.work, href: r("work", lang) },
    ]}
  >
    <p class="eyebrow mt-6"><b>{all.length}</b> {p.count}</p>
  </PageHead>

  <div class="pb-[clamp(4rem,10vh,8rem)]">
    <LayeredSlider lang={lang} items={sliderItems} />
  </div>

  <section class="wrap pb-[clamp(4rem,10vh,8rem)]" aria-labelledby="more-title">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-6 border-t border-line pt-12">
      <h2 id="more-title" class="display text-[length:var(--text-step-3)]">{copy.common.allWork}</h2>
      <div class="flex flex-wrap gap-2" role="group" aria-label={copy.common.allWork} data-filters>
        <button type="button" class="filter" data-filter="all" aria-pressed="true">{p.filters.all}</button>
        {restCats.map((cat) => <button type="button" class="filter" data-filter={cat} aria-pressed="false">{p.filters[cat]}</button>)}
      </div>
    </div>
    <div class="grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
      {rest.map((x) => <ProjectCard project={x} lang={lang} />)}
    </div>
    <p class="eyebrow mt-10" data-learning-note>{p.learningNote}</p>
  </section>
</Base>

<style>
  .filter {
    min-height: 44px;
    padding: 0.5rem 1.1rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    font-weight: 500;
    cursor: pointer;
    transition:
      background var(--dur-fast),
      color var(--dur-fast),
      border-color var(--dur-fast);
  }
  .filter:hover {
    border-color: var(--text);
  }
  .filter[aria-pressed="true"] {
    background: var(--text);
    color: var(--bg);
    border-color: var(--text);
  }
</style>
