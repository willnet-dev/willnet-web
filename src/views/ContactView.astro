---
// Contacto: formulario corto de presupuesto (acción principal), llamadas en Calendly + correo y teléfono (WhatsApp: el botón flotante).
// El formulario envía al servicio propio de WillNet (forms.willnet.dev: Worker + D1 + Turnstile + Resend,
// proyecto ../willnet-forms; plan en docs/plan-formularios-propios.md). Antes usaba Web3Forms (hasta 2026-11).
// En `npm run dev` apunta al Worker local (localhost:8787) y usa la clave de PRUEBA de Turnstile, que siempre aprueba.
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import Icon from "../components/Icon.astro";
import { r, type Lang } from "../i18n/routes";
import { calendlyHref, site, t } from "../i18n/ui";
import SocialIcons from "../components/SocialIcons.astro";
import { services } from "../data/services";
import { breadcrumbs } from "../lib/schema";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = t(lang);
const p = copy.contactPage;
const f = copy.form;
const FORM_ID = "willnet-contacto";
const formsEndpoint = import.meta.env.DEV
  ? `http://localhost:8787/v1/f/${FORM_ID}`
  : `https://forms.willnet.dev/v1/f/${FORM_ID}`;
// Site key de Turnstile (widget «willnet-forms»): es pública por diseño, va en el HTML de la página.
const turnstileSitekey = import.meta.env.DEV ? "1x00000000000000000000AA" : "0x4AAAAAAGHfQO5Fl3c9S8rK";
const b = p.booking;
const calls = [
  { href: calendlyHref("intro", "contact"), name: b.introName, meta: b.introMeta, text: b.introText },
  { href: calendlyHref("deep", "contact"), name: b.deepName, meta: b.deepMeta, text: b.deepText },
];
---

<Base
  lang={lang}
  title={p.title}
  description={p.description}
  hideTogether
  schema={[
    breadcrumbs([
      { name: copy.common.breadcrumbHome, path: r("home", lang) },
      { name: copy.nav.contact, path: r("contact", lang) },
    ]),
  ]}
>
  <PageHead
    eyebrow={p.eyebrow}
    title={p.h1}
    intro={p.intro}
    crumbs={[
      { name: copy.common.breadcrumbHome, href: r("home", lang) },
      { name: copy.nav.contact, href: r("contact", lang) },
    ]}
  />


  <!-- Una sola cuadrícula con tres piezas: formulario, llamadas de Calendly y otras formas de contacto.
       El orden en el HTML es el del teléfono (formulario → Calendly → correo y teléfono), para que el teclado y el
       lector de pantalla sigan lo que se ve en la pantalla principal. Desde 768 px Calendly vuelve arriba
       (md:order-first) y en escritorio ocupa las dos columnas, como antes (Willder, 2026-11-16). -->
  <div class="wrap grid gap-12 pb-[clamp(4rem,10vh,8rem)] lg:grid-cols-[1.5fr_1fr]">
    <form
      class="qform"
      data-quote-form
      data-endpoint={formsEndpoint}
      data-sitekey={turnstileSitekey}
      data-lang={lang}
      action={formsEndpoint}
      method="post"
      novalidate
    >
      <input type="hidden" name="language" value={lang} />
      <div class="sr-only" aria-hidden="true">
        <label for="botcheck">{f.honeypot}</label>
        <input type="checkbox" name="botcheck" id="botcheck" tabindex="-1" autocomplete="off" />
      </div>

      <div class="grid gap-6 sm:grid-cols-2">
        <div class="field">
          <label for="f-name">{f.name} <span aria-hidden="true">*</span></label>
          <input id="f-name" name="name" type="text" autocomplete="name" required aria-describedby="f-name-err" />
          <p class="field__err" id="f-name-err" data-err-required={f.required}></p>
        </div>
        <div class="field">
          <label for="f-email">{f.email} <span aria-hidden="true">*</span></label>
          <input id="f-email" name="email" type="email" autocomplete="email" inputmode="email" required aria-describedby="f-email-err" />
          <p class="field__err" id="f-email-err" data-err-required={f.required} data-err-invalid={f.invalidEmail}></p>
        </div>
        <div class="field">
          <label for="f-phone">{f.phone}</label>
          <input id="f-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" />
        </div>
        <div class="field">
          <label for="f-service">{f.service} <span aria-hidden="true">*</span></label>
          <select id="f-service" name="service" required aria-describedby="f-service-err">
            <option value="">{f.servicePlaceholder}</option>
            {services.map((s) => <option value={s[lang].name}>{s[lang].name}</option>)}
            <option value={f.serviceOther}>{f.serviceOther}</option>
          </select>
          <p class="field__err" id="f-service-err" data-err-required={f.required}></p>
        </div>

        <fieldset class="field sm:col-span-2">
          <legend>{f.hasSite}</legend>
          <div class="flex gap-3">
            <label class="choice"><input type="radio" name="has_website" value={f.yes} data-has-site /> {f.yes}</label>
            <label class="choice"><input type="radio" name="has_website" value={f.no} checked /> {f.no}</label>
          </div>
        </fieldset>
        <div class="field sm:col-span-2" data-site-url hidden>
          <label for="f-url">{f.siteUrl}</label>
          <input id="f-url" name="current_website" type="url" inputmode="url" placeholder="https://" aria-describedby="f-url-err" />
          <p class="field__err" id="f-url-err" data-err-invalid={f.invalidUrl}></p>
        </div>

        <div class="field sm:col-span-2">
          <label for="f-budget">{f.budget}</label>
          <select id="f-budget" name="budget">
            <option value="">{f.budgetPlaceholder}</option>
            {f.budgets.map((b) => <option value={b}>{b}</option>)}
          </select>
        </div>
        <div class="field sm:col-span-2">
          <label for="f-message">{f.message} <span aria-hidden="true">*</span></label>
          <textarea id="f-message" name="message" rows="5" required aria-describedby="f-message-hint f-message-err"></textarea>
          <p class="text-sm text-muted" id="f-message-hint">{f.messageHint}</p>
          <p class="field__err" id="f-message-err" data-err-required={f.required}></p>
        </div>
      </div>

      <!-- Turnstile (antispam de Cloudflare): se dibuja aquí con JavaScript y agrega el campo cf-turnstile-response. -->
      <div class="qform__turnstile mt-8" data-turnstile></div>

      <div class="mt-6 flex flex-wrap items-center gap-5">
        <button type="submit" class="btn btn-primary btn-lg" data-submit data-label={f.submit} data-sending={f.sending}>
          <span class="btn-label">{f.submit}</span>
        </button>
        <p class="text-sm text-muted">
          {f.privacy} <a href={r("privacy", lang)} class="text-link underline underline-offset-4">{f.privacyLink}</a>
        </p>
      </div>
      <p class="qform__status" data-status role="status" aria-live="polite" data-success={f.success} data-error={f.error} data-verify={f.verifyPending}></p>
    </form>

    <!-- Llamadas gratis en Calendly. Se abren en una ventana encima de la página: src/scripts/calendly.ts
         Teléfono: debajo del formulario (pedido de Willder, 2026-11-16; antes iban arriba, 2026-11-14).
         Tableta y escritorio: siguen arriba del formulario. -->
    <section class="md:order-first lg:col-span-2" aria-labelledby="book-title">
      <h2 id="book-title" class="eyebrow">// {b.title}</h2>
      <p class="mt-3 max-w-[60ch] text-muted">{b.intro}</p>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {
          calls.map((c) => (
            <a href={c.href} target="_blank" rel="noopener" class="contact-card" data-calendly data-magnetic data-magnetic-strength="0.12">
              <span class="contact-card__icon"><Icon name="calendar" /></span>
              <span class="contact-card__text">
                <span class="eyebrow">{c.meta}</span>
                <span class="text-[length:var(--text-step-1)] font-semibold">{c.name} ↗</span>
                <span class="contact-card__note text-sm text-muted">{c.text}</span>
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <aside class="grid content-start gap-4">
      <h2 class="eyebrow">// {p.other}</h2>
      <!-- Tarjetas con ícono y el mismo relleno que los botones al pasar el mouse (pedido de Willder, 2026-10-26).
           Sin tarjeta de WhatsApp en ningún tamaño: basta el botón flotante de la esquina (Willder, 2026-11-16) -->
      <a href={`mailto:${site.email}`} class="contact-card" data-magnetic data-magnetic-strength="0.12">
        <span class="contact-card__icon"><Icon name="email" /></span>
        <span class="contact-card__text">
          <span class="eyebrow">Email</span>
          <span class="text-[length:var(--text-step-1)] font-semibold break-all">{site.email}</span>
        </span>
      </a>
      <a href={site.phoneHref} class="contact-card" data-magnetic data-magnetic-strength="0.12">
        <span class="contact-card__icon"><Icon name="phone" /></span>
        <span class="contact-card__text">
          <span class="eyebrow">{p.phone}</span>
          <span class="text-[length:var(--text-step-1)] font-semibold">{site.phone}</span>
        </span>
      </a>

      <!-- Redes: solo íconos, centrados (decisión de Willder, 2026-10-26). En el teléfono no van: se repetían con
           las del pie, que ahora lleva también este texto (Willder, 2026-11-16) -->
      <div class="mt-4 grid gap-4 max-md:hidden">
        <h2 class="eyebrow text-center">// {p.social}</h2>
        <SocialIcons magnetic />
        <p class="mt-2 text-sm text-muted">{copy.footer.tagline}</p>
      </div>
    </aside>
  </div>
</Base>

<script>
  // Envío del formulario al servicio propio (forms.willnet.dev). Solo muestra éxito si responde { ok: true }.

  type Turnstile = {
    render: (el: HTMLElement, opts: Record<string, unknown>) => string;
    reset: (id?: string) => void;
    remove: (id: string) => void;
  };
  const tsWindow = window as Window & { turnstile?: Turnstile };

  // Carga el script de Turnstile una sola vez (modo explícito, para que funcione con las transiciones de Astro).
  let turnstileLoading: Promise<Turnstile> | null = null;
  const loadTurnstile = () =>
    (turnstileLoading ??= new Promise<Turnstile>((resolve, reject) => {
      if (tsWindow.turnstile) return resolve(tsWindow.turnstile);
      const s = document.createElement("script");
      s.src = "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit";
      s.async = true;
      s.onload = () => (tsWindow.turnstile ? resolve(tsWindow.turnstile) : reject(new Error("turnstile")));
      s.onerror = () => {
        turnstileLoading = null;
        reject(new Error("turnstile"));
      };
      document.head.appendChild(s);
    }));

  document.addEventListener("astro:page-load", () => {
    const form = document.querySelector<HTMLFormElement>("[data-quote-form]");
    if (!form) return;
    const endpoint = form.dataset.endpoint!;
    const status = form.querySelector<HTMLElement>("[data-status]")!;
    const submit = form.querySelector<HTMLButtonElement>("[data-submit]")!;
    const label = submit.querySelector<HTMLElement>(".btn-label")!;
    const siteWrap = form.querySelector<HTMLElement>("[data-site-url]")!;
    const widgetBox = form.querySelector<HTMLElement>("[data-turnstile]")!;

    let widgetId: string | undefined;
    loadTurnstile()
      .then((ts) => {
        if (!widgetBox.isConnected) return;
        widgetId = ts.render(widgetBox, {
          sitekey: form.dataset.sitekey,
          theme: document.documentElement.dataset.theme === "light" ? "light" : "dark",
          language: form.dataset.lang,
          // En teléfonos muy angostos (320 px) el tamaño normal (300 px) no cabe.
          size: widgetBox.clientWidth < 300 ? "compact" : "flexible",
          action: "contact",
        });
      })
      .catch(() => {
        /* Sin Turnstile el servidor rechaza el envío y se muestra el mensaje de error con correo y WhatsApp. */
      });
    document.addEventListener("astro:before-swap", () => widgetId && tsWindow.turnstile?.remove(widgetId), { once: true });

    form.querySelectorAll<HTMLInputElement>('input[name="has_website"]').forEach((radio) =>
      radio.addEventListener("change", () => {
        siteWrap.hidden = !form.querySelector<HTMLInputElement>("[data-has-site]")!.checked;
      }),
    );

    const setError = (field: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement, msg: string) => {
      const err = form.querySelector<HTMLElement>(`#${field.id}-err`);
      if (err) err.textContent = msg;
      field.setAttribute("aria-invalid", msg ? "true" : "false");
    };

    const validate = () => {
      let first: HTMLElement | null = null;
      form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>("input[id], select[id], textarea[id]").forEach((field) => {
        const err = form.querySelector<HTMLElement>(`#${field.id}-err`);
        if (!err || (field.closest("[hidden]") && field.id === "f-url")) {
          if (err) setError(field, "");
          return;
        }
        let msg = "";
        const value = field.value.trim();
        if (field.required && !value) msg = err.dataset.errRequired ?? "";
        else if (value && field instanceof HTMLInputElement && field.type === "email" && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)) msg = err.dataset.errInvalid ?? "";
        else if (value && field instanceof HTMLInputElement && field.type === "url" && !/^https?:\/\/\S+\.\S+/.test(value)) msg = err.dataset.errInvalid ?? "";
        setError(field, msg);
        if (msg && !first) first = field;
      });
      (first as HTMLElement | null)?.focus();
      return !first;
    };

    form.querySelectorAll("input[id], select[id], textarea[id]").forEach((field) =>
      field.addEventListener("input", () => {
        if (field.getAttribute("aria-invalid") === "true") setError(field as HTMLInputElement, "");
      }),
    );

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      status.textContent = "";
      status.dataset.state = "";
      if (!validate()) return;
      const token = form.querySelector<HTMLInputElement>('[name="cf-turnstile-response"]')?.value;
      if (!token) {
        status.textContent = status.dataset.verify!;
        status.dataset.state = "error";
        return;
      }

      submit.disabled = true;
      label.textContent = submit.dataset.sending!;
      try {
        const data = Object.fromEntries(new FormData(form).entries());
        const res = await fetch(endpoint, {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify(data),
        });
        const json = await res.json().catch(() => ({}));
        if (res.ok && json.ok) {
          form.reset();
          siteWrap.hidden = true;
          status.textContent = status.dataset.success!;
          status.dataset.state = "success";
        } else {
          throw new Error(json.error || res.statusText);
        }
      } catch {
        status.textContent = status.dataset.error!;
        status.dataset.state = "error";
      } finally {
        // Cada token de Turnstile sirve una sola vez: se pide otro para el siguiente envío.
        if (widgetId) tsWindow.turnstile?.reset(widgetId);
        submit.disabled = false;
        label.textContent = submit.dataset.label!;
      }
    });
  });
</script>

<style>
  .qform {
    padding: clamp(1.5rem, 4vw, 3rem);
    border-radius: 24px;
    border: 1px solid var(--line);
    background: var(--surface);
    box-shadow: var(--card-shadow);
  }
  .qform__notice {
    margin-bottom: 1.5rem;
    padding: 0.9rem 1.1rem;
    border-radius: 12px;
    border: 1px dashed var(--accent);
    font-size: var(--text-step--1);
  }
  :global([data-theme="light"]) .qform__notice {
    border-color: var(--link);
  }
  .field {
    display: grid;
    gap: 0.45rem;
    border: 0;
    padding: 0;
    margin: 0;
  }
  .field label,
  .field legend {
    font-weight: 600;
    font-size: var(--text-step--1);
    margin-bottom: 0.2rem;
  }
  .field input:not([type="radio"]):not([type="checkbox"]),
  .field select,
  .field textarea {
    width: 100%;
    min-height: 48px;
    padding: 0.75rem 0.9rem;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: var(--bg);
    color: var(--text);
    font: inherit;
    transition: border-color var(--dur-fast);
  }
  .field textarea {
    resize: vertical;
  }
  .field input:hover,
  .field select:hover,
  .field textarea:hover {
    border-color: var(--muted);
  }
  .field [aria-invalid="true"] {
    border-color: #ff6b6b;
  }
  :global([data-theme="light"]) .field [aria-invalid="true"] {
    border-color: #b42318;
  }
  .field__err {
    min-height: 0;
    font-size: var(--text-step--1);
    color: #ff8a8a;
  }
  :global([data-theme="light"]) .field__err {
    color: #b42318;
  }
  .field__err:empty {
    display: none;
  }
  .choice {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0 1rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    cursor: pointer;
    font-weight: 500 !important;
  }
  .choice input {
    accent-color: var(--accent);
    width: 18px;
    height: 18px;
  }
  .choice:has(input:checked) {
    border-color: var(--text);
  }
  .qform__status:not(:empty) {
    margin-top: 1.5rem;
    padding: 1rem 1.2rem;
    border-radius: 12px;
    font-weight: 600;
  }
  .qform__status[data-state="success"] {
    background: var(--accent);
    color: var(--accent-ink);
  }
  .qform__status[data-state="error"] {
    border: 1px solid #ff6b6b;
  }
  .btn:disabled {
    cursor: not-allowed;
    opacity: 0.55;
  }
  /* Mismo efecto que los botones: un relleno lima con borde curvo sube desde abajo */
  .contact-card {
    --card-fill: var(--accent);
    --card-fill-fg: var(--accent-ink);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: center;
    gap: 1rem;
    min-width: 0;
    padding: 1.2rem 1.4rem;
    border-radius: 18px;
    border: 1px solid var(--line);
    background: var(--surface);
    box-shadow: var(--card-shadow);
    text-decoration: none;
    transition:
      color var(--dur-base) var(--ease-out-expo),
      border-color var(--dur-base) var(--ease-out-expo);
  }
  .contact-card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--card-fill);
    border-radius: 50% 50% 0 0 / 100% 100% 0 0;
    transform: translateY(101%);
    transition:
      transform var(--dur-base) var(--ease-out-expo),
      border-radius var(--dur-base) var(--ease-out-expo);
  }
  .contact-card__icon {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--line);
    transition:
      border-color var(--dur-base) var(--ease-out-expo),
      transform var(--dur-base) var(--ease-out-expo);
  }
  .contact-card__text {
    display: grid;
    gap: 0.3rem;
    min-width: 0;
  }
  /* Mientras se descarga Calendly (primer clic) */
  .contact-card[aria-busy="true"] {
    cursor: progress;
    opacity: 0.75;
  }
  @media (hover: hover) {
    .contact-card:hover {
      color: var(--card-fill-fg);
      border-color: var(--card-fill);
    }
    .contact-card:hover::before {
      transform: translateY(0);
      border-radius: 0;
    }
    .contact-card:hover .eyebrow,
    .contact-card:hover .contact-card__note {
      color: inherit;
    }
    .contact-card:hover .contact-card__icon {
      border-color: currentColor;
      transform: rotate(-8deg);
    }
  }
</style>
