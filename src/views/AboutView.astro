---
// Sobre mí: historia de Willder, su foto (entra con un telón lima y se inclina en 3D con el mouse), cifras verificables que cuentan al aparecer, habilidades y formación.
// FOTO: public/img/willder-{720,1136}.{avif,webp} + willder.jpg de respaldo, generadas con `npm run about-photo`
// desde el original de Canva (1136×1408). Original y alternativas en originales/about/ (fuera del repo).
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import { r, type Lang } from "../i18n/routes";
import { site, t } from "../i18n/ui";
import { breadcrumbs } from "../lib/schema";
import { selfScore } from "../data/results";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = t(lang);
const a = copy.about;
const hasPhoto = true;
const realProjects = (await getCollection("work")).filter((p) => p.data.category !== "learning").length;
// Cifras verificables; cuentan desde 0 al entrar en pantalla (site.ts → data-count)
const stats = [
  { value: realProjects, label: a.statProjects },
  { value: 2, label: a.statLangs },
  { value: 30, label: a.statSupport },
  // 100 solo si accesibilidad y SEO están los dos en 100 (src/data/results.ts)
  { value: Math.min(selfScore("accessibility"), selfScore("seo")), unit: "/100", label: a.statScore },
];
const tools = ["HTML", "CSS", "JavaScript", "Tailwind CSS", "Astro", "React", "Three.js", "GSAP", "Node.js", "WordPress", "WooCommerce", "Stripe", "Cloudflare", "Git", "GitHub", "Figma", "Canva", "Claude Code"];

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${site.url}/#willder`,
  name: site.person,
  jobTitle: "Web developer",
  worksFor: { "@id": `${site.url}/#business` },
  address: { "@type": "PostalAddress", addressLocality: site.city, addressRegion: site.region, addressCountry: site.country },
  knowsLanguage: ["en", "es"],
  sameAs: [site.linkedin, site.github, site.instagram],
};
---

<Base
  lang={lang}
  title={a.title}
  description={a.description}
  schema={[
    breadcrumbs([
      { name: copy.common.breadcrumbHome, path: r("home", lang) },
      { name: copy.nav.about, path: r("about", lang) },
    ]),
    person,
  ]}
>
  <PageHead
    eyebrow={a.eyebrow}
    title={a.h1}
    crumbs={[
      { name: copy.common.breadcrumbHome, href: r("home", lang) },
      { name: copy.nav.about, href: r("about", lang) },
    ]}
  />

  <section class="wrap grid gap-12 pb-[clamp(4rem,10vh,7rem)] lg:grid-cols-[0.9fr_1.1fr] lg:items-start" data-parallax-root>
    <div class="about-photo" data-speed="-0.08">
      <!-- La inclinación 3D va en un elemento propio: el parallax ya mueve .about-photo con transform -->
      <div class="about-photo__tilt" data-tilt>
        <div class="about-photo__frame" data-reveal>
          {
            hasPhoto ? (
              <picture class="block h-full w-full">
                <source type="image/avif" srcset="/img/willder-720.avif 720w, /img/willder-1136.avif 1136w" sizes="(min-width: 768px) 520px, 92vw" />
                <source type="image/webp" srcset="/img/willder-720.webp 720w, /img/willder-1136.webp 1136w" sizes="(min-width: 768px) 520px, 92vw" />
                <img src="/img/willder.jpg" alt={a.photoAlt} width="1136" height="1408" class="h-full w-full object-cover" />
              </picture>
            ) : (
              <div class="about-photo__empty">
                <svg viewBox="0 0 416 290" width="96" fill="currentColor" aria-hidden="true"><path d="M0 0 96 37 156 203 107 290Z" /><path d="M416 0 320 37 260 203 309 290Z" /><path d="M160 64 208 83 256 64 208 174Z" /></svg>
                <span class="eyebrow">{a.photoSoon}</span>
              </div>
            )
          }
          <span class="about-photo__glare" aria-hidden="true" />
        </div>
      </div>
    </div>
    <div>
      <div class="prose-w grid gap-5 text-[length:var(--text-step-1)]">
        {a.intro.map((pp) => <p data-reveal>{pp}</p>)}
      </div>
      <dl class="mt-12 grid grid-cols-2 gap-x-6 gap-y-8 border-t border-line pt-8">
        {
          stats.map((st, i) => (
            <div data-reveal style={`--delay:${i * 80}ms`}>
              <dt class="sr-only">{st.label}</dt>
              <dd class="font-display text-[length:var(--text-step-4)] font-semibold tracking-tight whitespace-nowrap tabular-nums">
                <span data-count={st.value}>{st.value}</span>
                {st.unit && <span class="text-[0.45em] text-muted">{st.unit}</span>}
              </dd>
              <dd class="mt-1 text-sm text-muted" aria-hidden="true">{st.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="wrap border-t border-line py-[clamp(4rem,10vh,7rem)]" aria-labelledby="skills-title">
    <h2 id="skills-title" class="display mb-10 text-[length:var(--text-step-3)]" data-reveal>{a.skillsTitle}</h2>
    <div class="grid gap-10 md:grid-cols-3">
      {
        a.skills.map((g, i) => (
          <div data-reveal style={`--delay:${i * 80}ms`}>
            <h3 class="eyebrow mb-4">// {g.group}</h3>
            <ul class="grid gap-2">
              {g.items.map((it) => (
                <li class="border-b border-line pb-2">{it}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section class="wrap grid gap-10 border-t border-line py-[clamp(4rem,10vh,7rem)] lg:grid-cols-[1fr_1.4fr]" aria-labelledby="edu-title">
    <div>
      <h2 id="edu-title" class="display text-[length:var(--text-step-3)]" data-reveal>{a.eduTitle}</h2>
      <p class="mt-4 max-w-[44ch] text-muted" data-reveal>{a.eduText}</p>
    </div>
    <ol class="border-t border-line">
      {
        a.education.map((e) => (
          <li class="grid grid-cols-[1fr_auto] gap-4 border-b border-line py-5" data-reveal>
            <span>
              <span class="block font-semibold">{e.name}</span>
              <span class="text-muted">{e.org}</span>
            </span>
            <span class="eyebrow self-center">{e.date}</span>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="border-y border-line py-6" aria-label={a.toolsTitle}>
    <p class="wrap eyebrow mb-4">// {a.toolsTitle}</p>
    <div class="marquee" aria-hidden="true">
      {
        [0, 1].map(() => (
          <div class="marquee__track">
            {tools.map((tool) => (
              <span class="font-mono text-[length:var(--text-step-1)] whitespace-nowrap text-muted">{tool}</span>
            ))}
          </div>
        ))
      }
    </div>
    <p class="sr-only">{tools.join(", ")}</p>
  </section>
</Base>

<style>
  .about-photo {
    max-width: 520px;
  }
  /* Borde de 1 px con brillo que sigue al mouse, como los mosaicos de Servicios (--mx, --my: site.ts → initTilt) */
  .about-photo__tilt {
    padding: 1px;
    border-radius: 24px;
    background:
      radial-gradient(280px circle at var(--mx, -999px) var(--my, -999px), var(--accent), transparent 70%),
      var(--line);
  }
  .about-photo__frame {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: 23px;
    overflow: hidden;
    background: var(--surface);
  }
  /* Reflejo de luz que acompaña al mouse sobre la foto */
  .about-photo__glare {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(420px circle at var(--mx, 50%) var(--my, 0%), rgb(255 255 255 / 0.16), transparent 60%);
    opacity: 0;
    transition: opacity var(--dur-base);
  }
  @media (hover: hover) and (pointer: fine) {
    .about-photo__tilt:hover .about-photo__glare {
      opacity: 1;
    }
  }
  /* Entrada: un telón lima con la curva de los botones sube y descubre la foto, que se asienta (escala 1.15 → 1).
     Solo con JavaScript y sin «reducir movimiento»; si no, la foto se ve desde el principio */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .about-photo__frame[data-reveal] {
      opacity: 1;
      transform: none;
    }
    :global(.js) .about-photo__frame::after {
      content: "";
      position: absolute;
      inset: -1px;
      z-index: 2;
      background: var(--accent);
      transition:
        transform 1.2s var(--ease-out-expo) 0.15s,
        border-radius 1.2s var(--ease-out-expo) 0.15s;
    }
    :global(.js) .about-photo__frame.is-in::after {
      transform: translateY(-101%);
      border-radius: 0 0 50% 50% / 0 0 35% 35%;
    }
    :global(.js) .about-photo__frame picture {
      scale: 1.15;
      transition: scale 1.8s var(--ease-out-expo) 0.15s;
    }
    :global(.js) .about-photo__frame.is-in picture {
      scale: 1;
    }
  }
  .about-photo__empty {
    height: 100%;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 1rem;
    color: var(--wire);
    background: repeating-linear-gradient(-45deg, transparent 0 14px, color-mix(in oklab, var(--wire) 25%, transparent) 14px 15px);
  }
</style>
