---
// Página de inicio (EN y ES). Las rutas src/pages/index.astro y src/pages/es/index.astro solo la llaman.
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import MotionLab from "../components/MotionLab.astro";
import ProcessTimeline from "../components/services/ProcessTimeline.astro";
import PriceList from "../components/PriceList.astro";
import FaqList from "../components/FaqList.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ResultsStrip from "../components/ResultsStrip.astro";
import RsTile from "../components/RsTile.astro";
import { r, type Lang } from "../i18n/routes";
import { t } from "../i18n/ui";
import { services } from "../data/services";
import { faqFor } from "../data/faq";
import { faqPage } from "../lib/schema";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = t(lang);
const h = copy.home;
const featured = (await getCollection("work")).filter((p) => p.data.featured).sort((a, b) => a.data.order - b.data.order);
const homeFaq = faqFor(lang, true);
---

<Base lang={lang} title={h.title} description={h.description} schema={[faqPage(homeFaq)]}>
  <!-- HERO: la foto de Willder recortada (sin tarjeta) con el contorno lima de la W detrás (versión A, ronda 21).
       Parallax por capas al bajar (site.ts → data-parallax-layers; referencia: osmo.supply, «Parallax Image Layers»):
       el halo es el fondo y se queda más atrás, luego la W, el texto y por último la foto, que casi sigue al scroll -->
  <section class="hero" data-hero data-parallax-layers>
    <div class="hero__visual">
      <span class="hero__halo" data-parallax-layer="1" aria-hidden="true"></span>
      <svg class="hero__deco" data-parallax-layer="2" viewBox="-12 -12 440 314" aria-hidden="true">
        <path d="M0 0 96 37 156 203 107 290Z"></path>
        <path d="M416 0 320 37 260 203 309 290Z"></path>
        <path d="M160 64 208 83 256 64 208 174Z"></path>
      </svg>
      <!-- Recorte de la foto del estudio (1136 × 1408): se muestra a 700 px de alto como máximo para que
           en pantallas retina se vea a su tamaño real, sin estirarse -->
      <picture class="hero__pic" data-parallax-layer="4">
        <source type="image/avif" srcset="/img/hero/willder-recorte-720.avif 720w, /img/hero/willder-recorte-1136.avif 1136w" sizes="(min-width: 1100px) 565px, 420px" />
        <source type="image/webp" srcset="/img/hero/willder-recorte-720.webp 720w, /img/hero/willder-recorte-1136.webp 1136w" sizes="(min-width: 1100px) 565px, 420px" />
        <img src="/img/hero/willder-recorte-1136.webp" width="1136" height="1408" alt={h.photoAlt} fetchpriority="high" decoding="async" />
      </picture>
    </div>

    <div class="wrap hero__content" data-parallax-layer="3">
      <div class="hero__lead">
        <p class="eyebrow hero__role hero__in" style="--i:0"><b>&lt;{h.role}&gt;</b><span class="hero__brand"> · WillNet</span></p>
        <h1 class="display hero__title hero__in" style="--i:1">{h.h1}</h1>
      </div>
      <div class="hero__more">
        <p class="hero__type hero__in" style="--i:2">
          <span class="text-muted">{h.typePrefix}</span>
          <span class="hero__word" data-typewriter data-words={JSON.stringify(h.typeWords)}>{h.typeWords[0]}</span><span class="type-caret" aria-hidden="true"></span>
        </p>
        <p class="text-muted hero__in" style="--i:3">{h.support}</p>
        <div class="hero__actions mt-2 flex flex-wrap gap-3 hero__in" style="--i:4">
          <a href={r("contact", lang)} class="btn btn-primary btn-lg" data-magnetic><span class="btn-label">{copy.cta.quote}</span></a>
        </div>
      </div>
      <!-- Mouse animado (referencia: tamalsen.dev): el contorno se dibuja, un trazo lima da la vuelta,
           cae dentro como flecha que rebota y todo se recoge. Ciclo de 5 s en CSS (global.css).
           Va dentro del texto (capa 3 del parallax) para bajar junto con el botón: fuera de la capa, al hacer
           scroll en el celular el botón se le venía encima (Willder, 2026-11-18) -->
      <a href="#services" class="scroll-cue" aria-label={copy.common.scroll}>
        <svg class="mouse" viewBox="0 0 40 64" width="30" height="48" aria-hidden="true">
          <!-- Degradado arcoíris del contorno del mouse (estilo Resend, skin-resend.css) -->
          <defs>
            <linearGradient id="rs-mouse-grad" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="40" y2="64">
              <stop offset="0" stop-color="#02fcef"></stop>
              <stop offset="0.5" stop-color="#ffb52b"></stop>
              <stop offset="1" stop-color="#a02bfe"></stop>
              <animateTransform attributeName="gradientTransform" type="rotate" from="0 20 32" to="360 20 32" dur="8s" repeatCount="indefinite"></animateTransform>
            </linearGradient>
          </defs>
          <path class="mouse__outline" pathLength="100" d="M20 2C10 2 2 10 2 20v24c0 10 8 18 18 18s18-8 18-18V20C38 10 30 2 20 2Z"></path>
          <path class="mouse__chase" pathLength="100" d="M20 2C10 2 2 10 2 20v24c0 10 8 18 18 18s18-8 18-18V20C38 10 30 2 20 2Z"></path>
          <g class="mouse__arrow">
            <path class="mouse__stem" pathLength="100" d="M20 18v24"></path>
            <path class="mouse__head" pathLength="100" d="M13.5 35.5 20 42l6.5-6.5"></path>
          </g>
        </svg>
      </a>
    </div>

  </section>

  <!-- MARQUEE de servicios -->
  <div class="border-y border-line py-5" aria-hidden="true">
    <div class="marquee">
      {
        [0, 1].map(() => (
          <div class="marquee__track">
            {services.map((s) => (
              <span class="flex items-center gap-10 font-display text-[length:var(--text-step-2)] font-semibold tracking-tight whitespace-nowrap">
                {s[lang].name}
                <span class="h-3 w-3 rounded-full bg-accent" />
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <!-- SERVICIOS Y PRECIOS -->
  <section id="services" class="wrap py-[clamp(5rem,12vh,9rem)]" aria-labelledby="services-title">
    <div class="rs-head mb-12 grid gap-6 lg:grid-cols-[1.1fr_1fr] lg:items-end">
      <div>
        <RsTile icon="code" />
        <p class="eyebrow mb-4" data-reveal>{h.servicesEyebrow}</p>
        <h2 id="services-title" class="display max-w-[16ch] text-[length:var(--text-step-4)]" data-reveal>{h.servicesTitle}</h2>
      </div>
      <p class="max-w-[48ch] text-[length:var(--text-step-1)] text-muted" data-reveal>{h.servicesText}</p>
    </div>
    <PriceList lang={lang} />
  </section>

  <!-- Trabajo, resultados, 3D y «por qué» van en una columna flexible para cambiar el orden solo en el celular.
       El HTML sigue el orden del celular (trabajo primero) para que el teclado y los lectores de pantalla vayan
       en el mismo orden que se ve en la pantalla principal (teléfono primero) -->
  <div class="flex flex-col">
    <!-- TRABAJO DESTACADO con parallax. En el celular va justo debajo de «What I do» (Willder, 2026-11-16);
         desde 768 px vuelve debajo de «Why WillNet» con md:order-last -->
    <section class="wrap py-[clamp(4rem,10vh,8rem)] md:order-last" aria-labelledby="work-title" data-parallax-root>
      <div class="rs-head mb-12 flex flex-wrap items-end justify-between gap-6">
        <div>
          <RsTile icon="layers" />
          <p class="eyebrow mb-4" data-reveal>{h.workEyebrow}</p>
          <h2 id="work-title" class="display max-w-[16ch] text-[length:var(--text-step-4)]" data-reveal>{h.workTitle}</h2>
        </div>
        <a href={r("work", lang)} class="btn" data-magnetic><span class="btn-label">{copy.common.allWork} →</span></a>
      </div>
      <!-- Móvil: 2 columnas (4 proyectos); escritorio: 2 columnas desfasadas -->
      <div class="grid grid-cols-2 gap-x-3 gap-y-10 md:gap-x-8 md:gap-y-14">
        {
          featured.map((p, i) => (
            <div class:list={[{ "md:mt-24": i % 2 === 1 }]} data-reveal>
              <div data-speed={i % 2 === 1 ? "0.12" : "-0.06"}>
                <ProjectCard project={p} lang={lang} size="lg" mobileCompact />
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- RESULTADOS MEDIDOS (cifras reales de los casos) -->
    <ResultsStrip lang={lang} />

    <!-- 3D Y MOVIMIENTO: la W 3D, efectos visuales e interacción con el scroll (ronda 21; debajo de «Measured results» por pedido de Willder) -->
    <MotionLab lang={lang} />

    <!-- POR QUÉ WILLNET -->
    <section class="wrap py-[clamp(4rem,10vh,8rem)]" aria-labelledby="why-title">
      <div class="rs-head">
        <RsTile icon="spark" />
        <p class="eyebrow mb-4" data-reveal>{h.whyEyebrow}</p>
        <h2 id="why-title" class="display mb-12 max-w-[18ch] text-[length:var(--text-step-4)]" data-reveal>{h.whyTitle}</h2>
      </div>
      <div class="grid border-t border-line md:grid-cols-3">
        {
          h.why.map((w, i) => (
            <div class="why" data-reveal style={`--delay:${i * 80}ms`}>
              <p class="font-display text-[length:var(--text-step-5)] font-semibold leading-none tracking-tighter text-wire">{String(i + 1).padStart(2, "0")}</p>
              <h3 class="mt-6 text-[length:var(--text-step-2)] font-semibold tracking-tight">{w.title}</h3>
              <p class="mt-3 text-muted">{w.text}</p>
            </div>
          ))
        }
      </div>
    </section>
  </div>

  <!-- PROCESO: la línea de tiempo que estaba en Servicios (ronda 21; el proceso B pasó a Servicios) -->
  <ProcessTimeline lang={lang} eyebrow={h.processEyebrow} title={h.processTitle} />

  <!-- PREGUNTAS -->
  <section class="wrap grid gap-10 py-[clamp(4rem,10vh,8rem)] lg:grid-cols-[1fr_1.6fr]" aria-labelledby="faq-title">
    <div class="rs-head">
      <RsTile icon="chat" />
      <p class="eyebrow mb-4" data-reveal>{h.faqEyebrow}</p>
      <h2 id="faq-title" class="display text-[length:var(--text-step-4)]" data-reveal>{h.faqTitle}</h2>
      <a href={r("faq", lang)} class="btn mt-8" data-magnetic><span class="btn-label">{h.faqMore} →</span></a>
    </div>
    <FaqList items={homeFaq} />
  </section>
</Base>

<style>
  /* ---------- HERO (ronda 21): foto recortada + contorno de la W ----------
     Escritorio: texto a la izquierda y la foto a la derecha, apoyada abajo. Menos de 1100 px: la foto
     arriba al centro y el texto centrado debajo. --vis-h es el alto de la foto: nunca más de 700 px,
     para que en retina no se estire (la foto mide 1408) */
  .hero {
    --vis-h: min(84svh, 700px);
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: end;
    padding-top: var(--header-h);
    overflow: hidden;
    isolation: isolate;
  }
  .hero__visual {
    position: absolute;
    z-index: 1;
    right: clamp(0px, 3vw, 4rem);
    bottom: 0;
    height: var(--vis-h);
    aspect-ratio: 1136 / 1408;
    isolation: isolate;
    pointer-events: none;
  }
  /* Capa 1 (fondo): halo lima suave detrás de la cabeza */
  .hero__halo {
    position: absolute;
    inset: -6% -14% 18%;
    z-index: -2;
    background: radial-gradient(closest-side at 50% 42%, color-mix(in oklab, var(--accent) 20%, transparent), transparent);
  }
  /* Capa 2: contorno de la W de la marca detrás de los hombros */
  .hero__deco {
    position: absolute;
    z-index: -1;
    left: -6%;
    top: 16%;
    width: 112%;
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.4;
    stroke-linejoin: round;
    opacity: 0.8;
  }
  .hero__deco path {
    vector-effect: non-scaling-stroke;
  }
  :global([data-theme="light"]) .hero__deco {
    stroke: var(--link);
    opacity: 0.6;
  }
  /* Capa 4 (frente): la foto */
  /* Las dos máscaras van en elementos distintos y se multiplican solas: la vertical en la foto y la
     horizontal en <picture>. Con las dos capas en la misma imagen (mask-composite: intersect), el navegador
     integrado no las cruzaba y en el tema claro el borde de abajo de la foto dejaba una línea detrás del
     botón (Willder, 2026-11-18) */
  .hero__pic {
    display: block;
    height: 100%;
    -webkit-mask-image: linear-gradient(to left, transparent, #000 13%);
    mask-image: linear-gradient(to left, transparent, #000 13%);
  }
  .hero__pic img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: bottom center;
    /* Abajo se funde con el fondo; a la derecha, donde la foto corta el hombro, también */
    -webkit-mask-image: linear-gradient(to top, transparent, #000 18%);
    mask-image: linear-gradient(to top, transparent, #000 18%);
  }

  /* Capa 3: el texto */
  .hero__content {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 1.1rem;
    justify-items: start;
    padding-bottom: clamp(5.5rem, 14vh, 8rem);
    pointer-events: none;
  }
  .hero__lead,
  .hero__more {
    display: grid;
    gap: 1.1rem;
    justify-items: inherit;
  }
  .hero__content :is(p, h1, a) {
    pointer-events: auto;
  }
  /* «<Freelance Web Developer & Designer>» es largo: en el celular se reparte en líneas parejas y se omite
     «· WillNet», que ya está en el logo de arriba */
  .hero__role {
    text-wrap: balance;
  }
  @media (max-width: 639px) {
    .hero__brand {
      display: none;
    }
  }
  .hero__title {
    font-size: var(--text-step-5);
    max-width: 14ch;
  }
  @media (min-width: 1100px) {
    .hero__title {
      max-width: min(50vw, 15ch);
      font-size: clamp(2.6rem, 0.8rem + 3.9vw, 5.6rem);
    }
  }
  .hero__type {
    font-family: var(--font-mono);
    font-size: var(--text-step-1);
  }
  .hero__word {
    color: var(--text);
  }

  /* Menos de 1100 px: foto arriba al centro, texto centrado debajo */
  @media (max-width: 1099px) {
    .hero {
      --vis-h: min(48svh, 480px);
      align-items: start;
    }
    .hero__visual {
      top: var(--header-h);
      bottom: auto;
      right: auto;
      left: 50%;
      translate: -50% 0;
    }
    .hero__pic img {
      -webkit-mask-image: linear-gradient(to top, transparent 4%, #000 38%);
      mask-image: linear-gradient(to top, transparent 4%, #000 38%);
    }
    .hero__deco {
      left: -8%;
      top: 6%;
      width: 116%;
    }
    .hero__content {
      padding-top: calc(var(--vis-h) * 0.8);
      padding-bottom: 6.5rem;
      justify-items: center;
      text-align: center;
    }
    .hero__title {
      max-width: 16ch;
    }
    .hero__actions {
      justify-content: center;
    }
  }
  /* Celular (pedido de Willder, 2026-11-16): la foto ocupa la mayor parte de la pantalla y el título
     «Modern websites — built directly with you.» no se ve. Se oculta solo a la vista: sigue en el HTML
     como el H1 de la página, para Google y los lectores de pantalla */
  @media (max-width: 767px) {
    /* El texto va pegado abajo y la foto llena lo de arriba; el padding-top evita que el texto
       suba hasta la cara en pantallas bajas (ahí el hero crece un poco en vez de taparla) */
    .hero {
      --vis-h: min(70svh, 620px);
      align-items: end;
    }
    .hero__content {
      padding-top: calc(var(--vis-h) * 0.72);
      /* El mouse va en el flujo, debajo del botón (ver .scroll-cue más abajo). El parallax baja el texto
         al hacer scroll; este margen deja que el mouse se vea un rato antes de pasar detrás de la franja */
      padding-bottom: 3rem;
      gap: 0.9rem;
    }
    .hero__lead,
    .hero__more {
      gap: 0.9rem;
    }
    /* Tema claro: el texto es oscuro, así que la camiseta (oscura) se funde con el fondo antes de
       llegar al texto para que se lea bien */
    :global([data-theme="light"]) .hero__pic img {
      -webkit-mask-image: linear-gradient(to top, transparent 12%, #000 56%);
      mask-image: linear-gradient(to top, transparent 12%, #000 56%);
    }
    .hero__title {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  .scroll-cue {
    position: absolute;
    z-index: 2;
    left: 50%;
    bottom: clamp(1.25rem, 4vh, 2.5rem);
    translate: -50% 0;
    display: grid;
    place-items: center;
    padding: 0.5rem;
  }
  /* Celular: el mouse deja de flotar y va en el flujo, con aire debajo del botón «Get a free quote»;
     así baja con él al hacer scroll y no se le encima (Willder, 2026-11-18) */
  @media (max-width: 767px) {
    .scroll-cue {
      position: static;
      translate: none;
      margin-top: 1.25rem;
    }
  }
  .why {
    padding: 2rem 0 0;
  }
  @media (min-width: 768px) {
    .why {
      padding: 2.5rem 2rem 0 0;
    }
    .why + .why {
      padding-left: 2rem;
      border-left: 1px solid var(--line);
    }
  }

  /* Entrada del hero: solo un desplazamiento corto; el texto y la foto nunca están ocultos
     (ni sin JavaScript ni si la animación no corre) */
  @media (prefers-reduced-motion: no-preference) {
    .hero__in {
      animation: heroIn 700ms var(--ease-out-expo) both;
      animation-delay: calc(var(--i) * 60ms);
    }
    /* La entrada va en la imagen y el parallax en <picture>: así no se pisan los transform */
    .hero__pic img {
      animation: heroIn 1100ms var(--ease-out-expo) both;
    }
  }
  @keyframes heroIn {
    from {
      transform: translateY(24px);
    }
  }
</style>
