---
// Página de inicio (EN y ES). Las rutas src/pages/index.astro y src/pages/es/index.astro solo la llaman.
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import MotionLab from "../components/MotionLab.astro";
import Process from "../components/Process.astro";
import PriceList from "../components/PriceList.astro";
import FaqList from "../components/FaqList.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ResultsStrip from "../components/ResultsStrip.astro";
import { r, type Lang } from "../i18n/routes";
import { t } from "../i18n/ui";
import { services } from "../data/services";
import { faqFor } from "../data/faq";
import { faqPage } from "../lib/schema";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = t(lang);
const h = copy.home;
const featured = (await getCollection("work")).filter((p) => p.data.featured).sort((a, b) => a.data.order - b.data.order);
const homeFaq = faqFor(lang, true);
---

<Base lang={lang} title={h.title} description={h.description} schema={[faqPage(homeFaq)]}>
  <!-- Comparador temporal de la ronda 21 (2026-11-16): ?hero=a|b|c y ?seccion3d=a|b|c.
       Se quita cuando Willder elija. Sin parámetro: A y A -->
  <script is:inline>
    (() => {
      const q = new URLSearchParams(location.search);
      const pick = (k) => (/^[abc]$/.test(q.get(k) || "") ? q.get(k) : "a");
      document.documentElement.dataset.heroV = pick("hero");
      document.documentElement.dataset.labV = pick("seccion3d");
    })();
  </script>

  <!-- HERO: la foto de Willder recortada (sin tarjeta) y el texto. La W 3D pasó a la sección «3D y movimiento».
       Tres decoraciones para elegir: A · contorno de la W en lima, B · el nombre gigante detrás, C · disco lima y todo centrado -->
  <section class="hero" data-hero>
    <div class="wrap hero__name" aria-hidden="true">
      <svg viewBox="0 0 1000 170"><text x="500" y="150" text-anchor="middle" textLength="990" lengthAdjust="spacingAndGlyphs">WILLDER</text></svg>
    </div>

    <div class="hero__visual">
      <svg class="hero__deco hero__deco--w" viewBox="-12 -12 440 314" aria-hidden="true">
        <path d="M0 0 96 37 156 203 107 290Z"></path>
        <path d="M416 0 320 37 260 203 309 290Z"></path>
        <path d="M160 64 208 83 256 64 208 174Z"></path>
      </svg>
      <span class="hero__deco hero__deco--sun" aria-hidden="true"></span>
      <!-- Recorte de la foto del estudio (1136 × 1408): se muestra a 700 px de alto como máximo para que
           en pantallas retina se vea a su tamaño real, sin estirarse -->
      <picture class="hero__pic">
        <source type="image/avif" srcset="/img/hero/willder-recorte-720.avif 720w, /img/hero/willder-recorte-1136.avif 1136w" sizes="(min-width: 1100px) 565px, 420px" />
        <source type="image/webp" srcset="/img/hero/willder-recorte-720.webp 720w, /img/hero/willder-recorte-1136.webp 1136w" sizes="(min-width: 1100px) 565px, 420px" />
        <img src="/img/hero/willder-recorte-1136.webp" width="1136" height="1408" alt={h.photoAlt} fetchpriority="high" decoding="async" />
      </picture>
    </div>

    <div class="wrap hero__content">
      <div class="hero__lead">
        <p class="eyebrow hero__role hero__in" style="--i:0"><b>&lt;{h.role}&gt;</b><span class="hero__brand"> · WillNet</span></p>
        <h1 class="display hero__title hero__in" style="--i:1">{h.h1}</h1>
      </div>
      <div class="hero__more">
        <p class="hero__type hero__in" style="--i:2">
          <span class="text-muted">{h.typePrefix}</span>
          <span class="hero__word" data-typewriter data-words={JSON.stringify(h.typeWords)}>{h.typeWords[0]}</span><span class="type-caret" aria-hidden="true"></span>
        </p>
        <p class="text-muted hero__in" style="--i:3">{h.support}</p>
        <div class="hero__actions mt-2 flex flex-wrap gap-3 hero__in" style="--i:4">
          <a href={r("contact", lang)} class="btn btn-primary btn-lg" data-magnetic><span class="btn-label">{copy.cta.quote}</span></a>
        </div>
      </div>
    </div>

    <!-- Mouse animado (referencia: tamalsen.dev): el contorno se dibuja, un trazo lima da la vuelta,
         cae dentro como flecha que rebota y todo se recoge. Ciclo de 5 s en CSS (global.css) -->
    <a href="#services" class="scroll-cue" aria-label={copy.common.scroll}>
      <svg class="mouse" viewBox="0 0 40 64" width="30" height="48" aria-hidden="true">
        <path class="mouse__outline" pathLength="100" d="M20 2C10 2 2 10 2 20v24c0 10 8 18 18 18s18-8 18-18V20C38 10 30 2 20 2Z"></path>
        <path class="mouse__chase" pathLength="100" d="M20 2C10 2 2 10 2 20v24c0 10 8 18 18 18s18-8 18-18V20C38 10 30 2 20 2Z"></path>
        <g class="mouse__arrow">
          <path class="mouse__stem" pathLength="100" d="M20 18v24"></path>
          <path class="mouse__head" pathLength="100" d="M13.5 35.5 20 42l6.5-6.5"></path>
        </g>
      </svg>
    </a>
  </section>

  <!-- MARQUEE de servicios -->
  <div class="border-y border-line py-5" aria-hidden="true">
    <div class="marquee">
      {
        [0, 1].map(() => (
          <div class="marquee__track">
            {services.map((s) => (
              <span class="flex items-center gap-10 font-display text-[length:var(--text-step-2)] font-semibold tracking-tight whitespace-nowrap">
                {s[lang].name}
                <span class="h-3 w-3 rounded-full bg-accent" />
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <!-- SERVICIOS Y PRECIOS -->
  <section id="services" class="wrap py-[clamp(5rem,12vh,9rem)]" aria-labelledby="services-title">
    <div class="mb-12 grid gap-6 lg:grid-cols-[1.1fr_1fr] lg:items-end">
      <div>
        <p class="eyebrow mb-4" data-reveal>{h.servicesEyebrow}</p>
        <h2 id="services-title" class="display max-w-[16ch] text-[length:var(--text-step-4)]" data-reveal>{h.servicesTitle}</h2>
      </div>
      <p class="max-w-[48ch] text-[length:var(--text-step-1)] text-muted" data-reveal>{h.servicesText}</p>
    </div>
    <PriceList lang={lang} />
  </section>

  <!-- PROCESO (opción B) -->
  <Process lang={lang} eyebrow={h.processEyebrow} title={h.processTitle} />

  <!-- RESULTADOS MEDIDOS (cifras reales de los casos) -->
  <ResultsStrip lang={lang} />

  <!-- POR QUÉ WILLNET -->
  <section class="wrap py-[clamp(4rem,10vh,8rem)]" aria-labelledby="why-title">
    <p class="eyebrow mb-4" data-reveal>{h.whyEyebrow}</p>
    <h2 id="why-title" class="display mb-12 max-w-[18ch] text-[length:var(--text-step-4)]" data-reveal>{h.whyTitle}</h2>
    <div class="grid border-t border-line md:grid-cols-3">
      {
        h.why.map((w, i) => (
          <div class="why" data-reveal style={`--delay:${i * 80}ms`}>
            <p class="font-display text-[length:var(--text-step-5)] font-semibold leading-none tracking-tighter text-wire">{String(i + 1).padStart(2, "0")}</p>
            <h3 class="mt-6 text-[length:var(--text-step-2)] font-semibold tracking-tight">{w.title}</h3>
            <p class="mt-3 text-muted">{w.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- 3D Y MOVIMIENTO: la W 3D, efectos visuales e interacción con el scroll (ronda 21) -->
  <MotionLab lang={lang} />

  <!-- TRABAJO DESTACADO con parallax -->
  <section class="wrap py-[clamp(4rem,10vh,8rem)]" aria-labelledby="work-title" data-parallax-root>
    <div class="mb-12 flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="eyebrow mb-4" data-reveal>{h.workEyebrow}</p>
        <h2 id="work-title" class="display max-w-[16ch] text-[length:var(--text-step-4)]" data-reveal>{h.workTitle}</h2>
      </div>
      <a href={r("work", lang)} class="btn" data-magnetic><span class="btn-label">{copy.common.allWork} →</span></a>
    </div>
    <!-- Móvil: 2 columnas (4 proyectos); escritorio: 2 columnas desfasadas -->
    <div class="grid grid-cols-2 gap-x-3 gap-y-10 md:gap-x-8 md:gap-y-14">
      {
        featured.map((p, i) => (
          <div class:list={[{ "md:mt-24": i % 2 === 1 }]} data-reveal>
            <div data-speed={i % 2 === 1 ? "0.12" : "-0.06"}>
              <ProjectCard project={p} lang={lang} size="lg" mobileCompact />
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- PREGUNTAS -->
  <section class="wrap grid gap-10 py-[clamp(4rem,10vh,8rem)] lg:grid-cols-[1fr_1.6fr]" aria-labelledby="faq-title">
    <div>
      <p class="eyebrow mb-4" data-reveal>{h.faqEyebrow}</p>
      <h2 id="faq-title" class="display text-[length:var(--text-step-4)]" data-reveal>{h.faqTitle}</h2>
      <a href={r("faq", lang)} class="btn mt-8" data-magnetic><span class="btn-label">{h.faqMore} →</span></a>
    </div>
    <FaqList items={homeFaq} />
  </section>
</Base>

<style>
  /* ---------- HERO (ronda 21): foto recortada + texto ----------
     A (por defecto) y B: escritorio con el texto a la izquierda y la foto a la derecha, apoyada abajo.
     C y todas las pantallas de menos de 1100 px: la foto arriba al centro y el texto centrado debajo.
     --vis-h es el alto de la foto: nunca más de 700 px, para que en retina no se estire (la foto mide 1408) */
  .hero {
    --vis-h: min(84svh, 700px);
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: end;
    padding-top: var(--header-h);
    overflow: hidden;
    isolation: isolate;
  }
  .hero__visual {
    position: absolute;
    z-index: 1;
    right: clamp(0px, 3vw, 4rem);
    bottom: 0;
    height: var(--vis-h);
    aspect-ratio: 1136 / 1408;
    isolation: isolate;
    pointer-events: none;
  }
  /* Halo lima suave detrás de la cabeza */
  .hero__visual::before {
    content: "";
    position: absolute;
    inset: -6% -14% 18%;
    z-index: -2;
    background: radial-gradient(closest-side at 50% 42%, color-mix(in oklab, var(--accent) 20%, transparent), transparent);
  }
  .hero__pic {
    display: block;
    height: 100%;
  }
  .hero__pic img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: bottom center;
    /* Abajo se funde con el fondo; a la derecha, donde la foto corta el hombro, también */
    -webkit-mask-image: linear-gradient(to top, transparent, #000 18%), linear-gradient(to left, transparent, #000 13%);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to top, transparent, #000 18%), linear-gradient(to left, transparent, #000 13%);
    mask-composite: intersect;
  }
  .hero__deco {
    position: absolute;
    z-index: -1;
  }
  /* A · contorno de la W de la marca detrás de los hombros */
  .hero__deco--w {
    left: -6%;
    top: 16%;
    width: 112%;
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.4;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    opacity: 0.8;
  }
  .hero__deco--w path {
    vector-effect: non-scaling-stroke;
  }
  :global([data-theme="light"]) .hero__deco--w {
    stroke: var(--link);
    opacity: 0.6;
  }
  /* C · disco lima detrás de la cabeza */
  .hero__deco--sun {
    display: none;
    left: 13%;
    top: 4%;
    width: 74%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--accent);
  }
  /* B · el nombre gigante en contorno, detrás de la foto */
  .hero__name {
    display: none;
    position: absolute;
    inset-inline: 0;
    top: calc(var(--header-h) + 2svh);
    z-index: 0;
    pointer-events: none;
  }
  .hero__name svg {
    display: block;
    width: 100%;
    overflow: visible;
  }
  /* La letra variable tiene contornos que se cruzan por dentro: se rellena con el color del fondo
     encima del trazo (paint-order) para que solo se vea el borde de afuera */
  .hero__name text {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 168px;
    fill: var(--bg);
    stroke: var(--wire);
    stroke-width: 3.2;
    paint-order: stroke fill;
  }
  :global(html[data-hero-v="b"]) .hero__name,
  :global(html[data-hero-v="c"]) .hero__deco--sun {
    display: block;
  }
  :global(html[data-hero-v="b"]) .hero__deco--w,
  :global(html[data-hero-v="c"]) .hero__deco--w {
    display: none;
  }

  .hero__content {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 1.1rem;
    justify-items: start;
    padding-bottom: clamp(5.5rem, 14vh, 8rem);
    pointer-events: none;
  }
  .hero__lead,
  .hero__more {
    display: grid;
    gap: 1.1rem;
    justify-items: inherit;
  }
  .hero__content :is(p, h1, a) {
    pointer-events: auto;
  }
  /* «<Freelance Web Developer & Designer>» es largo: en el celular se reparte en líneas parejas y se omite
     «· WillNet», que ya está en el logo de arriba */
  .hero__role {
    text-wrap: balance;
  }
  @media (max-width: 639px) {
    .hero__brand {
      display: none;
    }
  }
  .hero__title {
    font-size: var(--text-step-5);
    max-width: 14ch;
  }
  /* Escritorio (A y B): el texto ocupa la columna izquierda y la foto la derecha */
  @media (min-width: 1100px) {
    .hero__title {
      max-width: min(50vw, 15ch);
      font-size: clamp(2.6rem, 0.8rem + 3.9vw, 5.6rem);
    }
  }
  .hero__type {
    font-family: var(--font-mono);
    font-size: var(--text-step-1);
  }
  .hero__word {
    color: var(--text);
  }

  /* Pantallas de menos de 1100 px (todas las versiones): foto arriba al centro, texto centrado debajo */
  @media (max-width: 1099px) {
    .hero {
      --vis-h: min(48svh, 480px);
      align-items: start;
    }
    .hero__visual {
      top: var(--header-h);
      bottom: auto;
      right: auto;
      left: 50%;
      translate: -50% 0;
    }
    .hero__pic img {
      -webkit-mask-image: linear-gradient(to top, transparent 4%, #000 38%), linear-gradient(to left, transparent, #000 12%);
      mask-image: linear-gradient(to top, transparent 4%, #000 38%), linear-gradient(to left, transparent, #000 12%);
    }
    .hero__content {
      padding-top: calc(var(--vis-h) * 0.8);
      padding-bottom: 6.5rem;
      justify-items: center;
      text-align: center;
    }
    .hero__title {
      max-width: 16ch;
    }
    .hero__actions {
      justify-content: center;
    }
    .hero__name {
      top: calc(var(--header-h) + var(--vis-h) * 0.1);
    }
    .hero__deco--w {
      left: -8%;
      top: 6%;
      width: 116%;
    }
  }
  @media (max-width: 767px) {
    .hero {
      --vis-h: min(44svh, 400px);
    }
    .hero__title {
      max-width: 13ch;
    }
  }
  /* C en escritorio: la misma composición centrada, con la foto más baja para que quepa el texto */
  @media (min-width: 1100px) {
    :global(html[data-hero-v="c"]) .hero {
      --vis-h: min(56svh, 560px);
      align-items: start;
    }
    :global(html[data-hero-v="c"]) .hero__visual {
      top: var(--header-h);
      bottom: auto;
      right: auto;
      left: 50%;
      translate: -50% 0;
    }
    :global(html[data-hero-v="c"]) .hero__pic img {
      -webkit-mask-image: linear-gradient(to top, transparent 4%, #000 34%), linear-gradient(to left, transparent, #000 12%);
      mask-image: linear-gradient(to top, transparent 4%, #000 34%), linear-gradient(to left, transparent, #000 12%);
    }
    :global(html[data-hero-v="c"]) .hero__content {
      padding-top: calc(var(--vis-h) * 0.78);
      padding-bottom: 6rem;
      justify-items: center;
      text-align: center;
    }
    :global(html[data-hero-v="c"]) .hero__title {
      max-width: 22ch;
      font-size: clamp(2.6rem, 1rem + 2.6vw, 4.4rem);
    }
    :global(html[data-hero-v="c"]) .hero__actions {
      justify-content: center;
    }
  }

  .scroll-cue {
    position: absolute;
    z-index: 2;
    left: 50%;
    bottom: clamp(1.25rem, 4vh, 2.5rem);
    translate: -50% 0;
    display: grid;
    place-items: center;
    padding: 0.5rem;
  }
  .why {
    padding: 2rem 0 0;
  }
  @media (min-width: 768px) {
    .why {
      padding: 2.5rem 2rem 0 0;
    }
    .why + .why {
      padding-left: 2rem;
      border-left: 1px solid var(--line);
    }
  }

  /* Entrada del hero: solo un desplazamiento corto; el texto y la foto nunca están ocultos
     (ni sin JavaScript ni si la animación no corre) */
  @media (prefers-reduced-motion: no-preference) {
    .hero__in {
      animation: heroIn 700ms var(--ease-out-expo) both;
      animation-delay: calc(var(--i) * 60ms);
    }
    .hero__pic {
      animation: heroIn 1100ms var(--ease-out-expo) both;
    }
  }
  @keyframes heroIn {
    from {
      transform: translateY(24px);
    }
  }
</style>
