---
import View from "../../../views/ServiceView.astro";
import { serviceSlugs, type ServiceKey } from "../../../i18n/routes";

export function getStaticPaths() {
  return (Object.keys(serviceSlugs) as ServiceKey[]).map((key) => ({ params: { slug: serviceSlugs[key].es }, props: { key } }));
}
const { key } = Astro.props;
---

<View lang="es" serviceKey={key} />
