---
// Cuenta regresiva del lanzamiento oficial (pedido de Willder, 2026-11-16).
// No se visita directamente: hasta la hora del lanzamiento, el Worker (worker/index.ts) la sirve en lugar de
// cualquier página de willnet.dev con el código 503 («cerrado un momento»), para que Google no pierda las páginas.
// A la hora del lanzamiento el Worker deja de servirla y la web se ve sola, sin publicar nada.
// Bilingüe en la misma página: el script de <head> elige el idioma (ruta /es, idioma del navegador o el botón).
// Rediseño del 2026-11-18 (pedido de Willder): estilo «Resend puro» de la web (negro, luz desde arriba, título con
// degradado, reloj de cristal con una luz que da la vuelta al borde) y lanzamiento a las 9:00 p. m. en Florida.
import "../styles/global.css";
import "../styles/skin-resend.css";
import Logo from "../components/Logo.astro";
import SocialIcons from "../components/SocialIcons.astro";
import { calendlyHref, whatsappHref } from "../i18n/ui";
import unboundedLatin from "@fontsource-variable/unbounded/files/unbounded-latin-wght-normal.woff2?url";
import geistLatin from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";

// Miércoles 18 de noviembre de 2026, 9:00 p. m. en Florida (EST, UTC−5). Igual que COUNTDOWN_UNTIL en wrangler.jsonc.
const LAUNCH = "2026-11-19T02:00:00Z";
// Sin «días»: el lanzamiento es en horas. Si faltara más de un día, las horas pasan de 24 (p. ej. 30:12:05).
const units = [
  { key: "h", en: "Hours", es: "Horas" },
  { key: "m", en: "Minutes", es: "Minutos" },
  { key: "s", en: "Seconds", es: "Segundos" },
];
---

<!doctype html>
<html lang="en" data-theme="dark" data-skin="resend">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>WillNet — Launching tonight · Llega esta noche</title>
    <meta name="description" content="The new willnet.dev launches tonight, Wednesday, November 18 at 9:00 pm ET. La nueva willnet.dev llega esta noche, miércoles 18 de noviembre, a las 9:00 p. m." />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#000000" />
    <link rel="preload" href={unboundedLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="WillNet" />
    <meta property="og:title" content="willnet.dev — Launching tonight, 9:00 pm ET" />
    <meta property="og:image" content="https://willnet.dev/og-willnet-en.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      (() => {
        let lang = null;
        try { lang = localStorage.getItem("cd-lang"); } catch {}
        if (!lang) lang = location.pathname.startsWith("/es") || (navigator.language || "").toLowerCase().startsWith("es") ? "es" : "en";
        document.documentElement.lang = lang;
        document.documentElement.classList.add("js");
      })();
    </script>
  </head>
  <body>
    <div class="cd" data-launch={LAUNCH}>
      <!-- Luz que cae desde arriba (la del hero) y la W del logo, solo el contorno y muy tenue, detrás del reloj -->
      <div class="cd__light" aria-hidden="true"></div>
      <svg class="cd__w" viewBox="0 0 416 290" aria-hidden="true">
        <path d="M0 0 96 37 156 203 107 290Z"></path>
        <path d="M416 0 320 37 260 203 309 290Z"></path>
        <path d="M160 64 208 83 256 64 208 174Z"></path>
      </svg>

      <header class="cd__top">
        <Logo class="h-6 w-auto sm:h-7" />
        <button type="button" class="btn cd__lang" data-lang-toggle>
          <span class="btn-label"><span data-l="en"><span aria-hidden="true">ES</span><span class="sr-only" lang="es">Ver en español</span></span><span data-l="es"><span aria-hidden="true">EN</span><span class="sr-only" lang="en">View in English</span></span></span>
        </button>
      </header>

      <main class="cd__main">
        <p class="cd__tag"><span class="cd__dot" aria-hidden="true"></span><span data-l="en">Tonight · 9:00 pm ET</span><span data-l="es">Esta noche · 9:00 p. m.</span></p>
        <h1 class="display cd__title">
          <span data-l="en">The new willnet.dev<br />is almost here.</span>
          <span data-l="es">La nueva willnet.dev<br />ya casi llega.</span>
        </h1>
        <p class="cd__intro">
          <span data-l="en">Modern websites, built directly with you. Opens <strong>tonight, Wednesday, November 18 at 9:00 pm ET</strong>.</span>
          <span data-l="es">Webs modernas, hechas directamente contigo. Abre <strong>esta noche, miércoles 18 de noviembre, a las 9:00 p. m. (hora de Florida)</strong>.</span>
        </p>

        <div class="cd__clock" role="timer" aria-live="off" data-clock>
          {
            units.map((u, i) => (
              <>
                {i > 0 && <span class="cd__sep" aria-hidden="true">:</span>}
                <div class="cd__cell">
                  <span class="cd__num" data-unit={u.key}>--</span>
                  <span class="cd__label">
                    <span data-l="en">{u.en}</span>
                    <span data-l="es">{u.es}</span>
                  </span>
                </div>
              </>
            ))
          }
        </div>
        <p class="cd__local" data-local hidden></p>
        <p class="cd__done" data-done hidden>
          <span data-l="en">We're live. Loading the new site…</span>
          <span data-l="es">Ya está en línea. Cargando la web nueva…</span>
        </p>

        <div class="cd__actions">
          <p class="cd__wait">
            <span data-l="en">Can't wait? Let's talk now.</span>
            <span data-l="es">¿No quieres esperar? Hablemos ya.</span>
          </p>
          <div class="cd__btns">
            <a href={calendlyHref("intro", "countdown")} target="_blank" rel="noopener" class="btn btn-primary btn-lg">
              <span class="btn-label"><span data-l="en">Book a free call</span><span data-l="es">Agenda una llamada gratis</span></span>
            </a>
            <a href={whatsappHref("en")} target="_blank" rel="noopener" class="btn btn-lg" data-l="en"><span class="btn-label">WhatsApp</span></a>
            <a href={whatsappHref("es")} target="_blank" rel="noopener" class="btn btn-lg" data-l="es"><span class="btn-label">WhatsApp</span></a>
          </div>
        </div>
      </main>

      <footer class="cd__foot">
        <SocialIcons />
        <p class="cd__copy">© 2026 WillNet · West Palm Beach, FL</p>
      </footer>
    </div>

    <script>
      // Cuenta regresiva: cada segundo hasta la hora del lanzamiento; al llegar a cero recarga la página
      // y el Worker ya sirve la web normal. El idioma se cambia con el botón y se recuerda en este navegador.
      const root = document.querySelector<HTMLElement>("[data-launch]")!;
      const launch = Date.parse(root.dataset.launch!);
      const html = document.documentElement;
      const nums = Object.fromEntries(
        [...root.querySelectorAll<HTMLElement>("[data-unit]")].map((el) => [el.dataset.unit!, el]),
      );
      const pad = (n: number) => String(n).padStart(2, "0");

      // Hora del lanzamiento en la zona del visitante (solo si no está en la hora de Florida)
      const local = root.querySelector<HTMLElement>("[data-local]")!;
      const zone = Intl.DateTimeFormat().resolvedOptions().timeZone;
      const renderLocal = () => {
        if (zone === "America/New_York") return;
        const es = html.lang === "es";
        const when = new Intl.DateTimeFormat(es ? "es" : "en", { weekday: "long", hour: "numeric", minute: "2-digit", timeZoneName: "short" }).format(launch);
        local.textContent = es ? `En tu zona horaria: ${when}.` : `In your time zone: ${when}.`;
        local.hidden = false;
      };
      renderLocal();

      document.querySelector("[data-lang-toggle]")?.addEventListener("click", () => {
        html.lang = html.lang === "es" ? "en" : "es";
        try { localStorage.setItem("cd-lang", html.lang); } catch {}
        renderLocal();
      });

      let timer = 0;
      const tick = () => {
        const left = Math.max(0, launch - Date.now());
        const s = Math.floor(left / 1000);
        nums.h.textContent = pad(Math.floor(s / 3600));
        nums.m.textContent = pad(Math.floor((s % 3600) / 60));
        nums.s.textContent = pad(s % 60);
        if (left === 0) {
          clearInterval(timer);
          root.querySelector<HTMLElement>("[data-done]")!.hidden = false;
          // Unos segundos de margen por si el reloj del visitante va adelantado
          setTimeout(() => location.reload(), 4000);
        }
      };
      tick();
      timer = window.setInterval(tick, 1000);
    </script>

    <style>
      html:not([lang="es"]) [data-l="es"],
      html[lang="es"] [data-l="en"] {
        display: none !important;
      }
      body {
        background: var(--bg);
        color: var(--text);
      }
      .cd {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        min-height: 100svh;
        display: grid;
        grid-template-rows: auto 1fr auto;
        gap: clamp(2rem, 5vh, 3.5rem);
        padding: 1.25rem clamp(1rem, 5vw, 4rem) 1.5rem;
      }
      /* La luz del hero de la web (skin-resend.css): foco desde arriba, otro frío a la derecha y un haz que respira */
      .cd__light,
      .cd__light::after {
        position: absolute;
        inset: 0;
        z-index: -2;
        pointer-events: none;
      }
      .cd__light {
        background:
          radial-gradient(ellipse 70% 50% at 50% -10%, var(--rs-hero-a), transparent 70%),
          radial-gradient(ellipse 40% 40% at 88% 4%, var(--rs-hero-b), transparent 70%);
      }
      .cd__light::after {
        content: "";
        background: linear-gradient(118deg, transparent 38%, var(--rs-beam) 47%, var(--rs-beam-2) 53%, transparent 60%);
        animation: rsBeam 9s ease-in-out infinite alternate;
      }
      .cd__w {
        position: absolute;
        z-index: -1;
        left: 50%;
        top: 56%;
        width: min(86vw, 900px);
        translate: -50% -50%;
        fill: none;
        stroke: var(--line);
        stroke-width: 0.8;
        opacity: 0.5;
      }
      .cd__top {
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .cd__lang {
        min-width: 48px;
        min-height: 48px;
        padding: 0 0.9rem;
      }
      .cd__main {
        align-self: center;
        justify-self: center;
        display: grid;
        justify-items: center;
        gap: clamp(1.1rem, 2.6vh, 1.75rem);
        width: 100%;
        max-width: 56rem;
        text-align: center;
      }
      /* Etiqueta con el borde arcoíris que gira, como la del hero */
      .cd__tag {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.45rem 1rem;
        font-family: var(--font-mono);
        font-size: var(--text-step--1);
        border: 1px solid transparent;
        border-radius: 999px;
        background:
          linear-gradient(var(--bg), var(--bg)) padding-box,
          linear-gradient(var(--rs-angle), rgb(2 252 239 / 0.55), rgb(255 181 43 / 0.55) 50%, rgb(160 43 254 / 0.55)) border-box;
        animation: rsSpin 8s linear infinite;
      }
      /* El lima queda en el logo y en este punto que late: lo único «encendido» de la página */
      .cd__dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--lime);
        animation: cd-pulse 2.4s var(--ease-out-expo) infinite;
      }
      @keyframes cd-pulse {
        0% { box-shadow: 0 0 0 0 rgb(212 255 58 / 0.55); }
        70%, 100% { box-shadow: 0 0 0 10px rgb(212 255 58 / 0); }
      }
      .cd__title {
        font-size: clamp(2.1rem, 1.2rem + 4.6vw, 5.4rem);
        line-height: 1.02;
        letter-spacing: -0.04em;
        text-wrap: balance;
      }
      .cd__intro {
        max-width: 42ch;
        font-size: var(--text-step-1);
        line-height: 1.45;
        color: var(--muted);
      }
      .cd__intro strong {
        color: var(--text);
        font-weight: 500;
      }
      /* Reloj de cristal: borde gris con una luz de color que da la vuelta (como las tarjetas de «What I do») */
      .cd__clock {
        display: grid;
        grid-template-columns: 1fr auto 1fr auto 1fr;
        align-items: center;
        width: 100%;
        max-width: 40rem;
        margin-top: clamp(0.5rem, 2vh, 1.25rem);
        padding: clamp(1.1rem, 3vw, 2rem) clamp(0.75rem, 3vw, 2rem);
        border: 1px solid transparent;
        border-radius: 24px;
        background:
          linear-gradient(#060607, #060607) padding-box,
          conic-gradient(from var(--rs-angle), transparent 0deg 285deg, var(--rs-light) 352deg, transparent 360deg) border-box,
          linear-gradient(var(--line), var(--line)) border-box;
        box-shadow: var(--card-shadow), 0 40px 120px -40px rgb(214 235 253 / 0.12);
        animation: rsOrbit 6s linear infinite;
      }
      .cd__cell {
        display: grid;
        gap: 0.5rem;
        justify-items: center;
      }
      .cd__num {
        font-family: var(--font-display);
        font-weight: 500;
        font-size: clamp(2.4rem, 1.4rem + 5vw, 5rem);
        line-height: 1;
        letter-spacing: -0.03em;
        color: #fff;
        font-variant-numeric: tabular-nums;
      }
      .cd__sep {
        font-family: var(--font-display);
        font-size: clamp(1.6rem, 1rem + 3vw, 3.4rem);
        line-height: 1;
        color: #3a3d40;
        padding-bottom: 1.6rem;
      }
      .cd__label {
        font-family: var(--font-mono);
        font-size: clamp(0.7rem, 0.62rem + 0.35vw, 0.85rem);
        color: var(--muted);
      }
      .cd__local {
        color: var(--muted);
        font-size: var(--text-step--1);
      }
      .cd__done {
        color: var(--text);
        font-weight: 500;
      }
      .cd__actions {
        display: grid;
        justify-items: center;
        gap: 0.9rem;
        margin-top: clamp(0.5rem, 2.5vh, 1.5rem);
      }
      .cd__wait {
        color: var(--muted);
      }
      .cd__btns {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.75rem;
      }
      @media (max-width: 639px) {
        .cd__btns {
          width: 100%;
        }
        .cd__btns > * {
          width: 100%;
        }
      }
      .cd__foot {
        display: grid;
        gap: 1rem;
        justify-items: center;
      }
      .cd__copy {
        font-family: var(--font-mono);
        font-size: var(--text-step--1);
        color: var(--muted);
      }
      @media (prefers-reduced-motion: reduce) {
        .cd__dot,
        .cd__tag,
        .cd__clock,
        .cd__light::after {
          animation: none;
        }
      }
    </style>
  </body>
</html>
